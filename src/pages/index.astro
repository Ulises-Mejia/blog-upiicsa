---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const targetUrl = `${base}/es/`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
    <title>Multimedia UPIICSA</title>
    <script is:inline define:vars={{ targetUrl }}>
      window.location.replace(targetUrl);
    </script>
  </head>
  <body style="margin:0;background:#00643A;display:flex;align-items:center;justify-content:center;height:100vh;color:white;font-family:sans-serif;">
    <p>Redirigiendo a Repositorio Multimedia UPIICSA...</p>
  </body>
</html>
