---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
  frontmatter={{
    title: '404 - Página no encontrada',
    description: 'La página que buscas no existe o ha sido movida.',
    template: 'splash',
    hero: {
      title: '404',
      tagline: 'Página no encontrada en el Repositorio de Multimedia UPIICSA. Verifica la URL o regresa al inicio del repositorio.',
      actions: [
        {
          text: '🏠 Volver al Inicio',
          link: '/es/',
          variant: 'primary',
        },
        {
          text: '👥 Ver Autores y Créditos',
          link: '/es/autores/',
          variant: 'secondary',
        },
      ],
    },
  }}
/>
