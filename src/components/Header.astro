---
import { siteBrand } from '../config/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = `${base}/es/`;
const homeLabel = 'Inicio';
const subtitle = siteBrand.subtitle.es;

const route = Astro.locals.starlightRoute;
const pageTitle = route?.entry?.data?.title || siteBrand.title;
const pathname = Astro.url.pathname;

// Insignia contextual corta para la cabecera al hacer scroll
let contextBadge = '';
const topicMatch = pathname.match(/\/unidad-(\d+)\/(\d+)-(\d+)-(\d+|bis)-/);
if (topicMatch) {
  const [, unitNum, major, minor, sub] = topicMatch;
  const roman = unitNum === '1' ? 'U-I' : unitNum === '2' ? 'U-II' : 'U-III';
  contextBadge = sub === 'bis' ? roman : `${major}.${minor}.${sub}`;
} else if (pathname.includes('/unidad-1/cuestionario')) {
  contextBadge = 'Quiz U-I';
} else if (pathname.includes('/unidad-2/cuestionario')) {
  contextBadge = 'Quiz U-II';
} else if (pathname.includes('/unidad-3/cuestionario')) {
  contextBadge = 'Quiz U-III';
} else if (pathname.includes('/identidad-ipn')) {
  contextBadge = 'IPN';
} else if (pathname.includes('/autores')) {
  contextBadge = 'Autores';
} else {
  contextBadge = 'Inicio';
}
---

<div class="header-custom sl-flex">
  <!-- GRUPO IZQUIERDO: MENÚ SANDWICH + LOGOS + MARCA (Y TÍTULO ANIMADO EN MÓVIL) -->
  <div class="header-brand-group sl-flex">
    <button
      id="menuToggle"
      class="menu-toggle"
      aria-label="Abrir menú lateral"
      title="Abrir menú lateral"
      aria-expanded="false"
      popovertarget="starlight__sidebar"
      type="button"
    >
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>

    <a href={homeHref} class="header-logos sl-flex" title="Ir al Inicio" aria-label="Ir al Inicio">
      <img src={siteBrand.ipnLogoUrl} alt={siteBrand.ipnLogoAlt} width="44" height="44" />
      <img src={siteBrand.upiicsaLogoUrl} alt={siteBrand.upiicsaLogoAlt} width="44" height="44" />
    </a>

    <div class="brand-swap-slot">
      <a href={homeHref} class="header-brand brand-default-layer" title="Ir al Inicio">
        <div class="brand-text">
          <div class="brand-title">
            {siteBrand.title}
            <span class="brand-badge">{siteBrand.badge}</span>
          </div>
          <span class="brand-subtitle">{subtitle}</span>
        </div>
      </a>

      <!-- En móvil (≤ 768px): el título de la página entra suavemente ocupando el lugar de la marca -->
      <button
        id="headerMobileTitleBtn"
        class="brand-mobile-title-btn"
        type="button"
        aria-hidden="true"
        tabindex="-1"
        title="Volver al inicio de la página"
      >
        {contextBadge && <span class="context-pill-badge context-pill-badge--sm">{contextBadge}</span>}
        <span class="brand-mobile-title-text">{pageTitle}</span>
      </button>
    </div>
  </div>

  <!-- CENTRO (ESCRITORIO Y TABLET > 768px): PÍLDORA ANIMADA CON EL TÍTULO DE LA PÁGINA -->
  <div class="header-scroll-context">
    <button
      id="headerCenterTitleBtn"
      class="header-scroll-pill"
      type="button"
      aria-hidden="true"
      tabindex="-1"
      title="Volver al inicio de la página"
    >
      {contextBadge && <span class="context-pill-badge">{contextBadge}</span>}
      <span class="header-scroll-pill__title">{pageTitle}</span>
      <span class="header-scroll-pill__up" aria-hidden="true">↑</span>
    </button>
  </div>

  <!-- GRUPO DERECHO: INICIO + TEMA + IDIOMA (ESTILO UNIFICADO Y CONSISTENTE) -->
  <div class="header-actions sl-flex">
    <!-- Botón Inicio -->
    <a href={homeHref} class="header-link-btn" title={homeLabel} aria-label={homeLabel}>
      <span class="btn-icon home-icon">🏠</span>
      <span class="nav-btn-text">{homeLabel}</span>
    </a>

    <!-- Botón Modo Oscuro / Claro interactivo -->
    <button
      id="themeToggleBtn"
      class="header-link-btn"
      type="button"
      aria-label="Cambiar tema"
      title="Cambiar tema"
    >
      <span id="themeIcon" class="btn-icon theme-icon">🌙</span>
      <span id="themeLabel" class="nav-btn-text">Oscuro</span>
    </button>

    <!-- Botón Cambio de Idioma con Google Translate -->
    <button
      id="langToggleBtn"
      class="header-link-btn"
      type="button"
      title="Traducir al Inglés"
      aria-label="Traducir al Inglés"
    >
      <span class="btn-icon lang-icon">🌐</span>
      <span id="langBtnText" class="nav-btn-text">English</span>
    </button>
  </div>
</div>

<!-- BARRA DE PROGRESO DE LECTURA EN EL BORDE INFERIOR DE LA CABECERA -->
<div class="header-progress-track" aria-hidden="true">
  <div id="headerProgressBar" class="header-progress-fill"></div>
</div>

<script>
  let cleanupScrollEffects: (() => void) | null = null;

  function setupMenuToggle() {
    const menuToggle = document.getElementById('menuToggle');
    if (!menuToggle) return;

    // Asegurar que cada carga de página comience con el menú cerrado
    document.documentElement.removeAttribute('data-sidebar-open');
    menuToggle.setAttribute('aria-expanded', 'false');
    menuToggle.setAttribute('aria-label', 'Abrir menú lateral');
    menuToggle.setAttribute('title', 'Abrir menú lateral');

    menuToggle.onclick = (e) => {
      const isDesktop = window.innerWidth >= 800;
      if (isDesktop) {
        e.preventDefault();
        e.stopPropagation();
        const isOpen = document.documentElement.getAttribute('data-sidebar-open') === 'true';
        const willOpen = !isOpen;
        
        if (willOpen) {
          document.documentElement.setAttribute('data-sidebar-open', 'true');
          menuToggle.setAttribute('aria-expanded', 'true');
          menuToggle.setAttribute('aria-label', 'Cerrar menú lateral');
          menuToggle.setAttribute('title', 'Cerrar menú lateral');
        } else {
          document.documentElement.removeAttribute('data-sidebar-open');
          menuToggle.setAttribute('aria-expanded', 'false');
          menuToggle.setAttribute('aria-label', 'Abrir menú lateral');
          menuToggle.setAttribute('title', 'Abrir menú lateral');
        }
      } else {
        const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
        menuToggle.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
      }
    };

    // Cerrar al hacer clic fuera del sidebar en escritorio
    document.addEventListener('click', (e) => {
      if (window.innerWidth >= 800 && document.documentElement.getAttribute('data-sidebar-open') === 'true') {
        const sidebarPane = document.getElementById('starlight__sidebar');
        const target = e.target as HTMLElement;
        if (sidebarPane && !sidebarPane.contains(target) && !menuToggle.contains(target)) {
          document.documentElement.removeAttribute('data-sidebar-open');
          menuToggle.setAttribute('aria-expanded', 'false');
          menuToggle.setAttribute('aria-label', 'Abrir menú lateral');
          menuToggle.setAttribute('title', 'Abrir menú lateral');
        }
      }
    });

    // Cerrar al presionar la tecla Escape en escritorio
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && document.documentElement.getAttribute('data-sidebar-open') === 'true') {
        document.documentElement.removeAttribute('data-sidebar-open');
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.setAttribute('aria-label', 'Abrir menú lateral');
        menuToggle.setAttribute('title', 'Abrir menú lateral');
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 800) {
        const sidebarPane = document.getElementById('starlight__sidebar');
        if (sidebarPane && typeof (sidebarPane as any).hidePopover === 'function') {
          try { (sidebarPane as any).hidePopover(); } catch(err) {}
        }
      }
    });
  }

  function setupScrollHeaderTitle() {
    if (cleanupScrollEffects) {
      cleanupScrollEffects();
      cleanupScrollEffects = null;
    }

    const root = document.documentElement;
    const centerBtn = document.getElementById('headerCenterTitleBtn');
    const mobileBtn = document.getElementById('headerMobileTitleBtn');
    const progressBar = document.getElementById('headerProgressBar');

    // Detectar el H1 visible real (en cuestionarios el #_top se oculta y el visible es .quiz-title)
    const getActiveHeading = (): HTMLElement | null => {
      const topH1 = document.getElementById('_top');
      if (topH1 && topH1.offsetParent !== null) return topH1;
      const quizH1 = document.querySelector<HTMLElement>('.quiz-title');
      if (quizH1 && quizH1.offsetParent !== null) return quizH1;
      return document.querySelector<HTMLElement>('main h1');
    };

    let isDocked = false;
    let rafId = 0;

    const setDockedState = (visible: boolean) => {
      if (visible === isDocked) return;
      isDocked = visible;
      if (visible) {
        root.setAttribute('data-header-title', 'visible');
      } else {
        root.removeAttribute('data-header-title');
      }
      const ariaVal = visible ? 'false' : 'true';
      const tabVal = visible ? '0' : '-1';
      centerBtn?.setAttribute('aria-hidden', ariaVal);
      centerBtn?.setAttribute('tabindex', tabVal);
      mobileBtn?.setAttribute('aria-hidden', ariaVal);
      mobileBtn?.setAttribute('tabindex', tabVal);
    };

    const getStickyTopOffset = (): number => {
      const headerEl = document.querySelector<HTMLElement>('header.header');
      const headerH = headerEl ? headerEl.getBoundingClientRect().height : 64;
      const mobileToc = document.querySelector<HTMLElement>('mobile-starlight-toc nav');
      const tocH =
        mobileToc && window.getComputedStyle(mobileToc).display !== 'none'
          ? mobileToc.getBoundingClientRect().height
          : 0;
      return headerH + tocH;
    };

    const updateOnScroll = () => {
      rafId = 0;

      // 1. Barra de progreso de lectura (GPU transform: scaleX)
      if (progressBar) {
        const doc = document.documentElement;
        const maxScroll = doc.scrollHeight - window.innerHeight;
        const ratio = maxScroll > 20 ? Math.min(1, Math.max(0, window.scrollY / maxScroll)) : 0;
        progressBar.style.transform = `scaleX(${ratio.toFixed(4)})`;
      }

      // 2. Transición del título hacia la cabecera con histéresis para evitar parpadeos
      const heading = getActiveHeading();
      if (!heading) {
        setDockedState(false);
        return;
      }

      const rect = heading.getBoundingClientRect();
      const triggerY = getStickyTopOffset() + 4;

      if (!isDocked) {
        if (rect.bottom <= triggerY && window.scrollY > 36) {
          setDockedState(true);
        }
      } else {
        if (rect.bottom > triggerY + 14 || window.scrollY <= 20) {
          setDockedState(false);
        }
      }
    };

    const scheduleUpdate = () => {
      if (!rafId) {
        rafId = window.requestAnimationFrame(updateOnScroll);
      }
    };

    const scrollToTop = () => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
    };

    centerBtn?.addEventListener('click', scrollToTop);
    mobileBtn?.addEventListener('click', scrollToTop);
    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate, { passive: true });

    // Estado inicial limpio
    root.removeAttribute('data-header-title');
    updateOnScroll();

    cleanupScrollEffects = () => {
      if (rafId) window.cancelAnimationFrame(rafId);
      centerBtn?.removeEventListener('click', scrollToTop);
      mobileBtn?.removeEventListener('click', scrollToTop);
      window.removeEventListener('scroll', scheduleUpdate);
      window.removeEventListener('resize', scheduleUpdate);
    };
  }

  function setupThemeToggle() {
    const themeBtn = document.getElementById('themeToggleBtn');
    const themeIcon = document.getElementById('themeIcon');
    const themeLabel = document.getElementById('themeLabel');
    if (!themeBtn) return;

    const isEn = document.documentElement.lang === 'en';

    function updateThemeUI(theme: string) {
      const isDark = theme === 'dark';
      if (themeIcon) themeIcon.textContent = isDark ? '☀️' : '🌙';
      if (themeLabel) themeLabel.textContent = isDark ? (isEn ? 'Light' : 'Claro') : (isEn ? 'Dark' : 'Oscuro');
      const title = isDark
        ? (isEn ? 'Switch to Light mode' : 'Cambiar a Modo Claro')
        : (isEn ? 'Switch to Dark mode' : 'Cambiar a Modo Oscuro');
      themeBtn.setAttribute('title', title);
      themeBtn.setAttribute('aria-label', title);
    }

    // Obtener tema actual
    const currentTheme = document.documentElement.dataset.theme || 
      (typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme') === 'dark' ? 'dark' : 'light');
    updateThemeUI(currentTheme);

    // Alternar tema al hacer clic
    themeBtn.onclick = (e) => {
      e.preventDefault();
      const current = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
      const nextTheme = current === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = nextTheme;
      try {
        localStorage.setItem('starlight-theme', nextTheme);
      } catch (err) {}
      updateThemeUI(nextTheme);
    };
  }

  function getGoogleTransCookie(): string {
    if (typeof document === 'undefined') return '';
    const match = document.cookie.match(/(?:^|;\s*)googtrans=([^;]*)/);
    return match ? decodeURIComponent(match[1]) : '';
  }

  function setupLangToggle() {
    const langBtn = document.getElementById('langToggleBtn');
    const langBtnText = document.getElementById('langBtnText');
    if (!langBtn) return;

    function isEnglishActive(): boolean {
      const cookie = getGoogleTransCookie();
      return cookie.includes('/en') || (typeof localStorage !== 'undefined' && localStorage.getItem('upiicsa_gt_lang') === 'en');
    }

    function updateBtnUI(isEn: boolean) {
      if (langBtnText) langBtnText.textContent = isEn ? 'Español' : 'English';
      const title = isEn ? 'Restaurar a Español' : 'Traducir al Inglés';
      langBtn.setAttribute('title', title);
      langBtn.setAttribute('aria-label', title);
    }

    updateBtnUI(isEnglishActive());

    function triggerGoogleTranslate(targetLang: string) {
      const select = document.querySelector<HTMLSelectElement>('.goog-te-combo');
      if (select) {
        select.value = targetLang;
        select.dispatchEvent(new Event('change'));
      } else {
        let retries = 0;
        const interval = setInterval(() => {
          retries++;
          const delayedSelect = document.querySelector<HTMLSelectElement>('.goog-te-combo');
          if (delayedSelect) {
            clearInterval(interval);
            delayedSelect.value = targetLang;
            delayedSelect.dispatchEvent(new Event('change'));
          } else if (retries > 8) {
            clearInterval(interval);
            window.location.reload();
          }
        }, 150);
      }
    }

    langBtn.onclick = (e) => {
      e.preventDefault();
      const isEn = isEnglishActive();
      const nextLang = isEn ? 'es' : 'en';

      const domain = window.location.hostname;
      if (nextLang === 'en') {
        document.cookie = 'googtrans=/es/en; path=/;';
        document.cookie = `googtrans=/es/en; path=/; domain=${domain};`;
        try { localStorage.setItem('upiicsa_gt_lang', 'en'); } catch(err) {}
      } else {
        document.cookie = 'googtrans=/es/es; path=/;';
        document.cookie = `googtrans=/es/es; path=/; domain=${domain};`;
        document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
        document.cookie = `googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=${domain};`;
        try { localStorage.setItem('upiicsa_gt_lang', 'es'); } catch(err) {}
      }

      updateBtnUI(nextLang === 'en');
      triggerGoogleTranslate(nextLang);
    };
  }

  function setupScrollRestoration() {
    if (typeof window !== 'undefined' && 'scrollRestoration' in history) {
      try {
        history.scrollRestoration = 'manual';
      } catch (err) {}
    }
  }

  function initHeader() {
    setupMenuToggle();
    setupScrollHeaderTitle();
    setupThemeToggle();
    setupLangToggle();
    setupScrollRestoration();
  }

  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>

<style>
  .header-custom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 100%;
    gap: 1rem;
  }

  .header-brand-group {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .header-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: inherit;
  }

  .header-logos {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .header-logos img {
    width: 44px;
    height: 44px;
    object-fit: contain;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    padding: 2px;
    box-sizing: border-box;
    transition: transform 0.2s ease;
  }

  .header-logos img:hover {
    transform: scale(1.08);
  }

  .brand-swap-slot {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .brand-default-layer {
    transition: transform 0.34s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.26s ease;
  }

  .brand-mobile-title-btn {
    display: none;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .brand-title {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .brand-badge {
    background: #D4AF37;
    color: #00361F;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 4px;
    text-transform: uppercase;
  }

  .brand-subtitle {
    font-size: 0.72rem;
    color: #D4AF37;
    font-weight: 600;
    letter-spacing: 0.8px;
  }

  /* ==========================================================================
     PÍLDORA CENTRAL ANIMADA CON EL TÍTULO DE LA PÁGINA (ESCRITORIO / TABLET)
     ========================================================================== */
  .header-scroll-context {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    padding-inline: 0.25rem;
  }

  .header-scroll-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: min(100%, 34rem);
    min-width: 0;
    padding: 5px 12px 5px 7px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(212, 175, 55, 0.42);
    color: #FFFFFF;
    font-family: inherit;
    font-size: 0.84rem;
    font-weight: 700;
    line-height: 1.2;
    cursor: pointer;
    outline: none;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.16);
    opacity: 0;
    transform: translateY(14px) scale(0.96);
    pointer-events: none;
    transition:
      opacity 0.28s ease,
      transform 0.36s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  :global(:root[data-theme='dark']) .header-scroll-pill {
    background: rgba(212, 175, 55, 0.12);
    border-color: rgba(212, 175, 55, 0.42);
    color: #F4E8C1;
  }

  :global(html[data-header-title='visible']) .header-scroll-pill {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .header-scroll-pill:hover {
    background: rgba(212, 175, 55, 0.22);
    border-color: #D4AF37;
    box-shadow: 0 4px 18px rgba(212, 175, 55, 0.28);
  }

  .header-scroll-pill:focus-visible {
    outline: 2px solid #D4AF37;
    outline-offset: 2px;
  }

  .context-pill-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: #D4AF37;
    color: #00361F;
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.4px;
    padding: 2px 7px;
    border-radius: 999px;
    line-height: 1.2;
  }

  .context-pill-badge--sm {
    font-size: 0.6rem;
    padding: 1px 5px;
    border-radius: 5px;
  }

  .header-scroll-pill__title {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .header-scroll-pill__up {
    flex-shrink: 0;
    font-size: 0.8rem;
    color: #D4AF37;
    opacity: 0.85;
    transition: transform 0.2s ease;
  }

  .header-scroll-pill:hover .header-scroll-pill__up {
    transform: translateY(-2px);
    opacity: 1;
  }

  /* ==========================================================================
     BARRA DORADA DE PROGRESO DE LECTURA EN EL BORDE INFERIOR DE LA CABECERA
     ========================================================================== */
  .header-progress-track {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -3px;
    height: 3px;
    pointer-events: none;
    overflow: hidden;
    z-index: 2;
  }

  .header-progress-fill {
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, #D4AF37 0%, #F4E8C1 55%, #D4AF37 100%);
    box-shadow: 0 0 10px rgba(212, 175, 55, 0.7);
    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
  }

  /* Botón de Menú Sandwich / Hamburguesa */
  .menu-toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    width: 38px;
    height: 38px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #FFFFFF;
    padding: 7px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.2, 0, 0, 1);
    flex-shrink: 0;
    outline: none;
  }

  .menu-toggle:hover {
    background: #D4AF37;
    color: #00361F;
    border-color: #D4AF37;
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(212, 175, 55, 0.35);
  }

  .menu-toggle .hamburger-bar {
    display: block;
    width: 20px;
    height: 2.2px;
    background-color: currentColor;
    border-radius: 2px;
    transition: all 0.2s ease;
  }

  /* Acciones de la Cabecera */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .header-link-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    font-size: 0.82rem;
    font-weight: 600;
    color: #FFFFFF;
    text-decoration: none;
    padding: 0 14px;
    height: 38px;
    box-sizing: border-box;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: all 0.25s cubic-bezier(0.2, 0, 0, 1);
    cursor: pointer;
    font-family: inherit;
    line-height: 1;
    outline: none;
    user-select: none;
  }

  .header-link-btn:hover {
    background: #D4AF37;
    color: #00361F;
