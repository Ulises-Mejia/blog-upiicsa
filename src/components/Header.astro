---
import Search from '@astrojs/starlight/components/Search.astro';
import { siteBrand } from '../config/site';
import { getUnitById, getUnitByPath } from '../config/units';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = `${base}/es/`;
const homeLabel = 'Inicio';
const subtitle = siteBrand.subtitle.es;

const route = Astro.locals.starlightRoute;
const pageTitle = route?.entry?.data?.title || siteBrand.title;
const hasToc = Boolean(route?.toc);
const firstSectionLabel =
  route?.toc?.items?.[1]?.text || route?.toc?.items?.[0]?.text || 'Resumen';
const pathname = Astro.url.pathname;

// Insignia contextual corta para la cabecera al hacer scroll
let contextBadge = '';
const topicMatch = pathname.match(/\/unidad-(\d+)\/(\d+)-(\d+)-(\d+|bis)-/);
const matchedUnit = getUnitByPath(pathname);
if (topicMatch) {
  const [, unitNum, major, minor, sub] = topicMatch;
  const unitCfg = getUnitById(Number(unitNum));
  contextBadge = sub === 'bis' ? (unitCfg?.short ?? `U-${unitNum}`) : `${major}.${minor}.${sub}`;
} else if (matchedUnit && pathname.includes('/cuestionario')) {
  contextBadge = `Quiz ${matchedUnit.short}`;
} else if (pathname.includes('/identidad-ipn')) {
  contextBadge = 'IPN';
} else if (pathname.includes('/autores')) {
  contextBadge = 'Autores';
} else {
  contextBadge = 'Inicio';
}
---

<div class="header-custom sl-flex" data-has-page-toc={hasToc ? 'true' : 'false'}>
  <!-- GRUPO IZQUIERDO: MENÚ SANDWICH + LOGOS + MARCA (Y PÍLDORA 2 LÍNEAS EN MÓVIL) -->
  <div class="header-brand-group sl-flex">
    <button
      id="menuToggle"
      class="menu-toggle"
      aria-label="Abrir menú lateral"
      title="Abrir menú lateral"
      aria-expanded="false"
      popovertarget="starlight__sidebar"
      type="button"
    >
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>

    <a href={homeHref} class="header-logos sl-flex" title="Ir al Inicio" aria-label="Ir al Inicio">
      <img src={siteBrand.ipnLogoUrl} alt={siteBrand.ipnLogoAlt} width="40" height="40" />
      <span class="header-logos-sep" aria-hidden="true"></span>
      <img src={siteBrand.upiicsaLogoUrl} alt={siteBrand.upiicsaLogoAlt} width="40" height="40" />
    </a>

    <div class="brand-swap-slot">
      <div class="brand-default-layer">
        <a href={homeHref} class="header-brand" title="Ir al Inicio">
          <div class="brand-text">
            <div class="brand-title">
              <span class="brand-title-text">{siteBrand.title}</span>
              <span class="brand-badge">{siteBrand.badge}</span>
            </div>
            <span class="brand-subtitle">{subtitle}</span>
          </div>
        </a>

        <!-- Acceso compacto al índice en móvil cuando estamos arriba de la página -->
        {hasToc && (
          <button
            id="headerMobileTopTocBtn"
            class="mobile-top-toc-trigger"
            type="button"
            aria-label="Ver secciones de esta página"
            aria-expanded="false"
            title="Secciones de esta página"
          >
            <span class="mobile-top-toc-trigger__label">Índice</span>
            <span class="toc-chevron" aria-hidden="true">▾</span>
          </button>
        )}
      </div>

      <!-- En móvil (≤ 768px): píldora interactiva de 2 líneas (Título + Sección activa + desplegable) -->
      <button
        id="headerMobileTitleBtn"
        class="brand-mobile-title-btn"
        type="button"
        aria-hidden="true"
        aria-expanded="false"
        tabindex="-1"
        title={hasToc ? 'Ver secciones de esta página' : 'Volver al inicio de la página'}
      >
        {contextBadge && <span class="context-pill-badge context-pill-badge--sm">{contextBadge}</span>}
        <span class="brand-mobile-title-stack">
          <span class="brand-mobile-title-text">{pageTitle}</span>
          {hasToc && (
            <span class="brand-mobile-section-line">
              <span class="section-arrow" aria-hidden="true">▸</span>
              <span class="js-header-active-section">{firstSectionLabel}</span>
            </span>
          )}
        </span>
        <span class="brand-mobile-title-action" aria-hidden="true">
          {hasToc ? <span class="toc-chevron">▾</span> : <span>↑</span>}
        </span>
      </button>
    </div>
  </div>

  <!-- CENTRO (ESCRITORIO Y TABLET > 768px) -->
  <div class="header-scroll-context">
    <!-- En tablet (769px - 1151px) al estar arriba de la página: acceso directo a las secciones -->
    {hasToc && (
      <button
        id="headerTabletTopTocBtn"
        class="header-tablet-toc-btn"
        type="button"
        aria-expanded="false"
        title="Secciones de esta página"
      >
        <span aria-hidden="true">📑</span>
        <span>En esta página</span>
        <span class="header-tablet-toc-btn__sep" aria-hidden="true">·</span>
        <span class="header-tablet-toc-btn__current js-header-active-section">{firstSectionLabel}</span>
        <span class="toc-chevron" aria-hidden="true">▾</span>
      </button>
    )}

    <!-- Barra animada del título al bajar (en escritorio sube arriba; en tablet abre secciones) -->
    <button
      id="headerCenterTitleBtn"
      class="header-scroll-pill"
      type="button"
      aria-hidden="true"
      aria-expanded="false"
      tabindex="-1"
      title="Volver al inicio de la página"
    >
      {contextBadge && <span class="context-pill-badge">{contextBadge}</span>}
      <span class="header-scroll-pill__stack">
        <span class="header-scroll-pill__title">{pageTitle}</span>
        {hasToc && (
          <span class="header-scroll-pill__section">
            <span class="section-arrow" aria-hidden="true">▸</span>
            <span class="js-header-active-section">{firstSectionLabel}</span>
          </span>
        )}
      </span>
      <span class="header-scroll-pill__up" aria-hidden="true">
        <span class="pill-icon-desktop">↑</span>
        <span class="pill-icon-tablet toc-chevron">{hasToc ? '▾' : '↑'}</span>
      </span>
    </button>
  </div>

  <!-- GRUPO DERECHO: BÚSQUEDA + INICIO + TEMA + IDIOMA (ESTILO UNIFICADO Y CONSISTENTE) -->
  <div class="header-actions sl-flex">
    <!-- Buscador Pagefind (Ctrl+K) -->
    <div class="header-search-slot">
      <Search />
    </div>

    <!-- Botón Inicio (oculto en móvil ≤ 540px: los escudos y UPII ya llevan al Inicio) -->
    <a href={homeHref} class="header-link-btn header-home-btn" title={homeLabel} aria-label={homeLabel}>
      <span class="btn-icon home-icon">🏠</span>
      <span class="nav-btn-text">{homeLabel}</span>
    </a>

    <!-- Botón Modo Oscuro / Claro interactivo -->
    <button
      id="themeToggleBtn"
      class="header-link-btn"
      type="button"
      aria-label="Cambiar tema"
      title="Cambiar tema"
    >
      <span id="themeIcon" class="btn-icon theme-icon">🌙</span>
      <span id="themeLabel" class="nav-btn-text">Oscuro</span>
    </button>

    <!-- Botón Cambio de Idioma con Google Translate -->
    <button
      id="langToggleBtn"
      class="header-link-btn"
      type="button"
      title="Traducir al Inglés"
      aria-label="Traducir al Inglés"
    >
      <span class="btn-icon lang-icon">🌐</span>
      <span id="langBtnText" class="nav-btn-text">English</span>
    </button>
  </div>
</div>

<!-- BARRA DE PROGRESO DE LECTURA EN EL BORDE INFERIOR DE LA CABECERA -->
<div class="header-progress-track" aria-hidden="true">
  <div id="headerProgressBar" class="header-progress-fill"></div>
</div>

<script>
  let cleanupMenuToggle: (() => void) | null = null;
  let cleanupScrollEffects: (() => void) | null = null;
  let cleanupThemeToggle: (() => void) | null = null;

  function setupMenuToggle() {
    if (cleanupMenuToggle) {
      cleanupMenuToggle();
      cleanupMenuToggle = null;
    }

    const menuToggle = document.getElementById('menuToggle');
    if (!menuToggle) return;

    const collapseSidebarUnits = () => {
      const sidebarPane = document.getElementById('starlight__sidebar');
      if (!sidebarPane) return;
      sidebarPane.querySelectorAll<HTMLDetailsElement>('.top-level > li > details[open]').forEach((d) => {
        d.open = false;
      });
    };

    const closeDesktopSidebar = () => {
      document.documentElement.removeAttribute('data-sidebar-open');
      menuToggle.setAttribute('aria-expanded', 'false');
      menuToggle.setAttribute('aria-label', 'Abrir menú lateral');
      menuToggle.setAttribute('title', 'Abrir menú lateral');
    };

    // Asegurar que cada carga de página comience con el menú y sus unidades cerrados
    closeDesktopSidebar();
    collapseSidebarUnits();
    window.requestAnimationFrame(collapseSidebarUnits);

    const onToggleClick = (e: MouseEvent) => {
      const isDesktop = window.innerWidth >= 800;
      if (isDesktop) {
        e.preventDefault();
        e.stopPropagation();
        const isOpen = document.documentElement.getAttribute('data-sidebar-open') === 'true';

        if (!isOpen) {
          collapseSidebarUnits();
          document.documentElement.setAttribute('data-sidebar-open', 'true');
          menuToggle.setAttribute('aria-expanded', 'true');
          menuToggle.setAttribute('aria-label', 'Cerrar menú lateral');
          menuToggle.setAttribute('title', 'Cerrar menú lateral');
        } else {
          closeDesktopSidebar();
        }
      } else {
        const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
        if (!isExpanded) collapseSidebarUnits();
        menuToggle.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
      }
    };

    // Cerrar al hacer clic fuera del sidebar en escritorio
    const onDocumentClick = (e: MouseEvent) => {
      if (window.innerWidth >= 800 && document.documentElement.getAttribute('data-sidebar-open') === 'true') {
        const sidebarPane = document.getElementById('starlight__sidebar');
        const target = e.target as HTMLElement;
        if (sidebarPane && !sidebarPane.contains(target) && !menuToggle.contains(target)) {
          closeDesktopSidebar();
        }
      }
    };

    // Cerrar al presionar la tecla Escape en escritorio
    const onWindowKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && document.documentElement.getAttribute('data-sidebar-open') === 'true') {
        closeDesktopSidebar();
      }
    };

    const onWindowResize = () => {
      if (window.innerWidth >= 800) {
        const sidebarPane = document.getElementById('starlight__sidebar');
        if (sidebarPane && typeof (sidebarPane as any).hidePopover === 'function') {
          try { (sidebarPane as any).hidePopover(); } catch(err) {}
        }
      }
    };

    menuToggle.addEventListener('click', onToggleClick);
    document.addEventListener('click', onDocumentClick);
    window.addEventListener('keydown', onWindowKeyDown);
    window.addEventListener('resize', onWindowResize);

    cleanupMenuToggle = () => {
      menuToggle.removeEventListener('click', onToggleClick);
      document.removeEventListener('click', onDocumentClick);
      window.removeEventListener('keydown', onWindowKeyDown);
      window.removeEventListener('resize', onWindowResize);
    };
  }

  function setupScrollHeaderTitle() {
    if (cleanupScrollEffects) {
      cleanupScrollEffects();
      cleanupScrollEffects = null;
    }

    const root = document.documentElement;
    const centerBtn = document.getElementById('headerCenterTitleBtn');
    const mobileBtn = document.getElementById('headerMobileTitleBtn');
    const mobileTopTocBtn = document.getElementById('headerMobileTopTocBtn');
    const tabletTopTocBtn = document.getElementById('headerTabletTopTocBtn');
    const progressBar = document.getElementById('headerProgressBar');
    const mobileTocDetails = document.getElementById('starlight__mobile-toc') as HTMLDetailsElement | null;
    const displayCurrent = document.querySelector<HTMLElement>('mobile-starlight-toc .display-current');
    const sectionLabels = Array.from(document.querySelectorAll<HTMLElement>('.js-header-active-section'));

    const isCompactTocMode = () => window.innerWidth < 1152 && Boolean(mobileTocDetails);

    // Detectar el H1 visible real (en cuestionarios el #_top se oculta y el visible es .quiz-title)
    const getActiveHeading = (): HTMLElement | null => {
      const topH1 = document.getElementById('_top');
      if (topH1 && topH1.offsetParent !== null) return topH1;
      const quizH1 = document.querySelector<HTMLElement>('.quiz-title');
      if (quizH1 && quizH1.offsetParent !== null) return quizH1;
      return document.querySelector<HTMLElement>('main h1');
    };

    // Sincronizar en vivo el nombre de la sección activa en la cabecera (Opción B)
    const syncActiveSectionText = () => {
      const text = displayCurrent?.textContent?.trim();
      if (!text) return;
      sectionLabels.forEach((el) => {
        el.textContent = text;
      });
    };

    let sectionObserver: MutationObserver | null = null;
    if (displayCurrent && sectionLabels.length > 0) {
      syncActiveSectionText();
      sectionObserver = new MutationObserver(syncActiveSectionText);
      sectionObserver.observe(displayCurrent, {
        childList: true,
        characterData: true,
        subtree: true,
      });
    }

    // Sincronizar estado abierto/cerrado del desplegable de secciones (flecha ▾ + aria-expanded)
    const syncTocOpenState = () => {
      const open = Boolean(mobileTocDetails?.open);
      if (open) {
        root.setAttribute('data-mobile-toc-open', 'true');
      } else {
        root.removeAttribute('data-mobile-toc-open');
      }
      const expanded = open ? 'true' : 'false';
      mobileTopTocBtn?.setAttribute('aria-expanded', expanded);
      tabletTopTocBtn?.setAttribute('aria-expanded', expanded);
      if (isCompactTocMode()) {
        centerBtn?.setAttribute('aria-expanded', expanded);
        mobileBtn?.setAttribute('aria-expanded', expanded);
      }
    };

    const toggleMobileToc = (e: Event) => {
      if (!mobileTocDetails) return;
      e.preventDefault();
      e.stopPropagation();
      mobileTocDetails.open = !mobileTocDetails.open;
      syncTocOpenState();
    };

    mobileTocDetails?.addEventListener('toggle', syncTocOpenState);

    let isDocked = false;
    let rafId = 0;
    const usesCssScrollTimeline =
      typeof CSS !== 'undefined' &&
      CSS.supports('animation-timeline', 'scroll()') &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const setDockedState = (visible: boolean) => {
      if (visible === isDocked) return;
      isDocked = visible;
      if (visible) {
        root.setAttribute('data-header-title', 'visible');
      } else {
        root.removeAttribute('data-header-title');
      }
      const ariaVal = visible ? 'false' : 'true';
      const tabVal = visible ? '0' : '-1';
      centerBtn?.setAttribute('aria-hidden', ariaVal);
      centerBtn?.setAttribute('tabindex', tabVal);
      mobileBtn?.setAttribute('aria-hidden', ariaVal);
      mobileBtn?.setAttribute('tabindex', tabVal);
    };

    const updateOnScroll = () => {
      rafId = 0;

      // 1. Barra de progreso de lectura (fallback JS solo cuando el navegador no soporta Scroll-Driven Animations)
      if (progressBar && !usesCssScrollTimeline) {
        const doc = document.documentElement;
        const maxScroll = doc.scrollHeight - window.innerHeight;
        const ratio = maxScroll > 20 ? Math.min(1, Math.max(0, window.scrollY / maxScroll)) : 0;
        progressBar.style.transform = `scaleX(${ratio.toFixed(4)})`;
      }

      // 2. Transición del título hacia la cabecera con histéresis
      const heading = getActiveHeading();
      if (!heading) {
        setDockedState(false);
        return;
      }

      const headerEl = document.querySelector<HTMLElement>('header.header');
      const headerH = headerEl ? headerEl.getBoundingClientRect().height : 64;
      const rect = heading.getBoundingClientRect();
      const triggerY = headerH + 6;

      if (!isDocked) {
        if (rect.bottom <= triggerY && window.scrollY > 36) {
          setDockedState(true);
        }
      } else {
        if (rect.bottom > triggerY + 14 || window.scrollY <= 20) {
          setDockedState(false);
        }
      }
    };

    const scheduleUpdate = () => {
      if (!rafId) {
        rafId = window.requestAnimationFrame(updateOnScroll);
      }
    };

    const scrollToTop = () => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
    };

    // En móvil y tablet (< 72rem) con índice: tocar la píldora despliega secciones. En escritorio: sube al inicio.
    const onCenterClick = (e: Event) => {
      if (isCompactTocMode()) {
        toggleMobileToc(e);
      } else {
        scrollToTop();
      }
    };

    const onMobileClick = (e: Event) => {
      if (isCompactTocMode()) {
        toggleMobileToc(e);
      } else {
        scrollToTop();
      }
    };

    centerBtn?.addEventListener('click', onCenterClick);
    mobileBtn?.addEventListener('click', onMobileClick);
    mobileTopTocBtn?.addEventListener('click', toggleMobileToc);
    tabletTopTocBtn?.addEventListener('click', toggleMobileToc);
    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate, { passive: true });

    // Estado inicial limpio
    root.removeAttribute('data-header-title');
    root.removeAttribute('data-mobile-toc-open');
    updateOnScroll();

    cleanupScrollEffects = () => {
      if (rafId) window.cancelAnimationFrame(rafId);
      sectionObserver?.disconnect();
      mobileTocDetails?.removeEventListener('toggle', syncTocOpenState);
      centerBtn?.removeEventListener('click', onCenterClick);
      mobileBtn?.removeEventListener('click', onMobileClick);
      mobileTopTocBtn?.removeEventListener('click', toggleMobileToc);
      tabletTopTocBtn?.removeEventListener('click', toggleMobileToc);
      window.removeEventListener('scroll', scheduleUpdate);
      window.removeEventListener('resize', scheduleUpdate);
    };
  }

  function setupThemeToggle() {
    if (cleanupThemeToggle) {
      cleanupThemeToggle();
      cleanupThemeToggle = null;
    }

    const themeBtn = document.getElementById('themeToggleBtn');
    const themeIcon = document.getElementById('themeIcon');
    const themeLabel = document.getElementById('themeLabel');
    if (!themeBtn) return;

    const isEn = document.documentElement.lang === 'en';
    const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');

    const getSystemTheme = (): 'light' | 'dark' => (mediaQuery.matches ? 'dark' : 'light');

    const getStoredTheme = (): 'light' | 'dark' | null => {
      try {
        const stored = localStorage.getItem('starlight-theme');
        return stored === 'light' || stored === 'dark' ? stored : null;
      } catch {
        return null;
      }
    };

    const syncColorSchemeMeta = (scheme: 'light' | 'dark' | 'light dark') => {
      let meta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]');
      if (!meta) {
        meta = document.createElement('meta');
        meta.name = 'color-scheme';
        document.head.appendChild(meta);
      }
      meta.content = scheme;
    };

    function updateThemeUI(theme: 'light' | 'dark') {
      const isDark = theme === 'dark';
      if (themeIcon) themeIcon.textContent = isDark ? '☀️' : '🌙';
      if (themeLabel) themeLabel.textContent = isDark ? (isEn ? 'Light' : 'Claro') : (isEn ? 'Dark' : 'Oscuro');
      const title = isDark
        ? (isEn ? 'Switch to Light mode' : 'Cambiar a Modo Claro')
        : (isEn ? 'Switch to Dark mode' : 'Cambiar a Modo Oscuro');
      themeBtn?.setAttribute('title', title);
      themeBtn?.setAttribute('aria-label', title);
    }

    const applyColorScheme = (stored: 'light' | 'dark' | null) => {
      const effective: 'light' | 'dark' = stored ?? getSystemTheme();
      syncColorSchemeMeta(stored ?? 'light dark');
      document.documentElement.dataset.theme = effective;
      updateThemeUI(effective);
    };

    applyColorScheme(getStoredTheme());

    // Alternar en 2 estados: si el destino coincide con el SO, vuelve a seguir al sistema
    const onThemeClick = (e: MouseEvent) => {
      e.preventDefault();
      const currentRendered: 'light' | 'dark' =
        document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
      const target: 'light' | 'dark' = currentRendered === 'dark' ? 'light' : 'dark';
      const system = getSystemTheme();
      const nextStored: 'light' | 'dark' | null = target === system ? null : target;

      try {
        if (nextStored) {
          localStorage.setItem('starlight-theme', nextStored);
        } else {
          localStorage.removeItem('starlight-theme');
        }
      } catch {
        // Aplicar igualmente aunque el almacenamiento esté bloqueado
      }

      applyColorScheme(nextStored);
    };

    // Sincronizar cambios desde otras pestañas
    const onStorageChange = (e: StorageEvent) => {
      if (e.key === 'starlight-theme' || e.key === null) {
        applyColorScheme(getStoredTheme());
      }
    };

    // Reaccionar a cambios del SO solo cuando no hay override explícito almacenado
    const onSystemSchemeChange = () => {
      if (!getStoredTheme()) {
        applyColorScheme(null);
      }
    };

    themeBtn.addEventListener('click', onThemeClick);
    window.addEventListener('storage', onStorageChange);
    mediaQuery.addEventListener('change', onSystemSchemeChange);

    cleanupThemeToggle = () => {
      themeBtn.removeEventListener('click', onThemeClick);
      window.removeEventListener('storage', onStorageChange);
      mediaQuery.removeEventListener('change', onSystemSchemeChange);
    };
  }

  function getGoogleTransCookie(): string {
    if (typeof document === 'undefined') return '';
    const match = document.cookie.match(/(?:^|;\s*)googtrans=([^;]*)/);
    return match ? decodeURIComponent(match[1]) : '';
  }

  function setupLangToggle() {
    const langBtn = document.getElementById('langToggleBtn');
    const langBtnText = document.getElementById('langBtnText');
    if (!langBtn) return;

    function isEnglishActive(): boolean {
      const cookie = getGoogleTransCookie();
      return cookie.includes('/en') || (typeof localStorage !== 'undefined' && localStorage.getItem('upiicsa_gt_lang') === 'en');
    }

    function updateBtnUI(isEn: boolean) {
      if (langBtnText) langBtnText.textContent = isEn ? 'Español' : 'English';
      const title = isEn ? 'Restaurar a Español' : 'Traducir al Inglés';
      langBtn?.setAttribute('title', title);
      langBtn?.setAttribute('aria-label', title);
    }

    updateBtnUI(isEnglishActive());

    function triggerGoogleTranslate(targetLang: string) {
      (window as any).__loadGoogleTranslate?.();
      const select = document.querySelector<HTMLSelectElement>('.goog-te-combo');
      if (select) {
        select.value = targetLang;
        select.dispatchEvent(new Event('change'));
      } else {
        let retries = 0;
        const interval = setInterval(() => {
          retries++;
          const delayedSelect = document.querySelector<HTMLSelectElement>('.goog-te-combo');
          if (delayedSelect) {
            clearInterval(interval);
            delayedSelect.value = targetLang;
            delayedSelect.dispatchEvent(new Event('change'));
          } else if (retries > 20) {
            clearInterval(interval);
            window.location.reload();
          }
        }, 150);
      }
    }

    langBtn.onclick = (e) => {
      e.preventDefault();
      const isEn = isEnglishActive();
      const nextLang = isEn ? 'es' : 'en';

      const domain = window.location.hostname;
      if (nextLang === 'en') {
        document.cookie = 'googtrans=/es/en; path=/;';
        document.cookie = `googtrans=/es/en; path=/; domain=${domain};`;
        try { localStorage.setItem('upiicsa_gt_lang', 'en'); } catch(err) {}
      } else {
        document.cookie = 'googtrans=/es/es; path=/;';
        document.cookie = `googtrans=/es/es; path=/; domain=${domain};`;
        document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
        document.cookie = `googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=${domain};`;
        try { localStorage.setItem('upiicsa_gt_lang', 'es'); } catch(err) {}
      }

      updateBtnUI(nextLang === 'en');
      triggerGoogleTranslate(nextLang);
    };
  }

  function setupScrollRestoration() {
    if (typeof window !== 'undefined' && 'scrollRestoration' in history) {
      try {
        history.scrollRestoration = 'manual';
      } catch (err) {}
    }
  }

  function initHeader() {
    setupMenuToggle();
    setupScrollHeaderTitle();
    setupThemeToggle();
    setupLangToggle();
    setupScrollRestoration();
  }

  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>

<style>
  .header-custom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 100%;
    gap: 1rem;
  }

  .header-brand-group {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .header-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: inherit;
    min-width: 0;
  }

  .header-logos {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 3px 7px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(244, 232, 193, 0.24);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16);
    text-decoration: none;
    flex-shrink: 0;
    transition: max-width 0.32s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.22s ease, transform 0.3s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  .header-logos:hover {
    border-color: rgba(212, 175, 55, 0.58);
    background: rgba(212, 175, 55, 0.14);
  }

  .header-logos-sep {
    width: 1px;
    height: 22px;
    background: linear-gradient(180deg, transparent 0%, rgba(212, 175, 55, 0.78) 50%, transparent 100%);
    flex-shrink: 0;
  }

  .header-logos img {
    width: 38px;
    height: 38px;
    object-fit: contain;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    padding: 2px;
    box-sizing: border-box;
    filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.25));
    transition: transform 0.2s ease;
  }

  .header-logos img:hover {
    transform: scale(1.07);
  }

  .brand-swap-slot {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .brand-default-layer {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    transition: transform 0.34s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.26s ease;
  }

  .mobile-top-toc-trigger,
  .brand-mobile-title-btn,
  .header-tablet-toc-btn {
    display: none;
  }

  .toc-chevron {
    display: inline-block;
    transition: transform 0.24s cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(html[data-mobile-toc-open='true']) .toc-chevron {
    transform: rotate(180deg);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    min-width: 0;
    overflow: hidden;
  }

  .brand-title {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  .brand-title-text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .brand-badge {
    background: linear-gradient(135deg var(--in-oklab), #E4C45A 0%, #D4AF37 100%);
    color: #00361F;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 5px;
    text-transform: uppercase;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.22);
  }

  .brand-subtitle {
    font-size: 0.72rem;
    color: #F4E8C1;
    font-weight: 600;
    letter-spacing: 0.85px;
    opacity: 0.92;
  }

  /* ==========================================================================
     BARRA CENTRAL ANIMADA CON EL TÍTULO DE LA PÁGINA (ESCRITORIO / TABLET)
     ========================================================================== */
  .header-scroll-context {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    height: 46px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    padding-inline: 0.5rem;
  }

  .header-scroll-pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    width: 100%;
    max-width: 58rem;
    min-width: 0;
    height: 46px;
    padding: 6px 10px;
    box-sizing: border-box;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.14);
    border: 1.5px solid rgba(212, 175, 55, 0.55);
    color: #FFFFFF;
    font-family: inherit;
    font-size: clamp(1.08rem, 1.5vw, 1.32rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.2;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.16);
    opacity: 0;
    transform: translateY(16px) scale(0.98);
    pointer-events: none;
    transition:
      opacity 0.28s ease,
      transform 0.36s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  :global(:root[data-theme='dark']) .header-scroll-pill {
    background: rgba(212, 175, 55, 0.13);
    border-color: rgba(212, 175, 55, 0.52);
    color: #F4E8C1;
  }

  :global(html[data-header-title='visible']) .header-scroll-pill {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .header-scroll-pill:hover {
    background: rgba(212, 175, 55, 0.22);
    border-color: #D4AF37;
    box-shadow: 0 6px 24px rgba(212, 175, 55, 0.32);
  }

  :is(
      .header-scroll-pill,
      .menu-toggle,
      .header-link-btn,
      .header-tablet-toc-btn,
      .mobile-top-toc-trigger,
      .brand-mobile-title-btn,
      .header-logos,
      .header-brand
    ):focus-visible {
    outline: 2.5px solid #D4AF37;
    outline-offset: 2px;
  }

  .context-pill-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: #D4AF37;
    color: #00361F;
    font-size: 0.86rem;
    font-weight: 900;
    letter-spacing: 0.45px;
    padding: 5px 12px;
    border-radius: 8px;
    line-height: 1.15;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.22);
  }

  .context-pill-badge--sm {
    font-size: 0.72rem;
    padding: 3px 7px;
    border-radius: 6px;
  }

  .header-scroll-pill__stack {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .header-scroll-pill__title {
    max-width: 100%;
    text-align: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* En escritorio (≥ 72rem), la sección activa vive en el panel derecho, así que aquí solo mostramos el título grande */
  .header-scroll-pill__section {
    display: none;
  }

  .section-arrow {
    color: #D4AF37;
    font-weight: 900;
    flex-shrink: 0;
  }

  .header-scroll-pill__up {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: rgba(212, 175, 55, 0.18);
    border: 1px solid rgba(212, 175, 55, 0.35);
    font-size: 1rem;
    font-weight: 900;
    color: #F4E8C1;
    transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .pill-icon-tablet {
    display: none;
  }

  .header-scroll-pill:hover .header-scroll-pill__up {
    transform: translateY(-2px);
    background: #D4AF37;
    color: #00361F;
  }

  /* ==========================================================================
     BARRA DORADA DE PROGRESO DE LECTURA EN EL BORDE INFERIOR DE LA CABECERA
     ========================================================================== */
  .header-progress-track {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -3px;
    height: 3px;
    pointer-events: none;
    overflow: hidden;
    z-index: 2;
  }

  .header-progress-fill {
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg var(--in-oklab), #D4AF37 0%, #F4E8C1 55%, #D4AF37 100%);
    box-shadow: 0 0 10px rgba(212, 175, 55, 0.65);
    transform: scaleX(0);
    transform-origin: left center;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      @keyframes header-grow-progress {
        from {
          transform: scaleX(0);
        }
        to {
          transform: scaleX(1);
        }
      }

      .header-progress-fill {
        animation-name: header-grow-progress;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
      }

      /* Regla separada para evitar que LightningCSS mezcle animation-timeline en el shorthand animation */
      #headerProgressBar.header-progress-fill {
        animation-timeline: scroll(root block);
      }
    }
  }

  /* Botón de Menú Sandwich / Hamburguesa */
  .menu-toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    width: 38px;
    height: 38px;
    background: linear-gradient(180deg var(--in-oklab), rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0.06) 100%);
    border: 1px solid rgba(244, 232, 193, 0.26);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16);
    color: #FFFFFF;
    padding: 7px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.2, 0, 0, 1);
    flex-shrink: 0;
  }

  .menu-toggle:hover {
    background: linear-gradient(135deg var(--in-oklab), #E4C45A 0%, #D4AF37 100%);
    color: #00361F;
    border-color: #E4C45A;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(212, 175, 55, 0.32);
  }

  .menu-toggle .hamburger-bar {
    display: block;
    width: 20px;
    height: 2.2px;
    background-color: currentColor;
    border-radius: 2px;
    transition: all 0.2s ease;
  }

  /* Acciones de la Cabecera */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .header-link-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    font-size: 0.82rem;
    font-weight: 600;
    color: #FFFFFF;
    text-decoration: none;
    padding: 0 14px;
    height: 38px;
    box-sizing: border-box;
    border-radius: 8px;
    background: linear-gradient(180deg var(--in-oklab), rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0.06) 100%);
    border: 1px solid rgba(244, 232, 193, 0.26);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16);
    transition: all 0.25s cubic-bezier(0.2, 0, 0, 1);
    cursor: pointer;
    font-family: inherit;
    line-height: 1;
    user-select: none;
  }

  .header-link-btn:hover {
    background: linear-gradient(135deg var(--in-oklab), #E4C45A 0%, #D4AF37 100%);
    color: #00361F;
    border-color: #E4C45A;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(212, 175, 55, 0.32);
  }

  /* Iconos dentro de los botones */
  .btn-icon {
    display: inline-block;
    font-size: 0.95rem;
    line-height: 1;
  }

  .theme-icon {
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .header-link-btn:hover .theme-icon {
    transform: rotate(25deg) scale(1.18);
  }

  .home-icon,
  .lang-icon {
    transition: transform 0.2s ease;
  }

  .header-link-btn:hover .home-icon,
  .header-link-btn:hover .lang-icon {
    transform: scale(1.15);
  }

  /* ==========================================================================
     TABLET (769px - 1151px): OPCIÓN B INTEGRADA EN LA BARRA CENTRAL
     ========================================================================== */
  @media (max-width: 71.99rem) and (min-width: 769px) {
    .brand-subtitle {
      display: none;
    }

    .header-custom {
      gap: 0.65rem;
    }

    .header-actions {
      gap: 6px;
    }

    .header-link-btn {
      padding: 0 10px;
    }

    /* Pill superior antes del scroll para acceder al índice sin ocupar segunda barra */
    .header-tablet-toc-btn {
      position: absolute;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      max-width: 100%;
      height: 38px;
      padding: 0 14px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(212, 175, 55, 0.45);
      color: #FFFFFF;
      font-family: inherit;
      font-size: 0.84rem;
      font-weight: 700;
      white-space: nowrap;
      overflow: hidden;
      cursor: pointer;
      opacity: 1;
      transform: translateY(0);
      transition: opacity 0.25s ease, transform 0.32s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.2s ease;
    }

    :global(:root[data-theme='dark']) .header-tablet-toc-btn {
      background: rgba(212, 175, 55, 0.12);
      color: #F4E8C1;
    }

    .header-tablet-toc-btn:hover {
      background: rgba(212, 175, 55, 0.22);
      border-color: #D4AF37;
    }

    .header-tablet-toc-btn__sep {
      color: #D4AF37;
      flex-shrink: 0;
    }

    .header-tablet-toc-btn__current {
      flex: 0 1 auto;
      min-width: 0;
      max-width: 18ch;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      color: #F4E8C1;
      font-weight: 600;
    }

    :global(html[data-header-title='visible']) .header-tablet-toc-btn {
      opacity: 0;
      transform: translateY(-16px);
      pointer-events: none;
    }

    /* En tablet al bajar: 2 líneas (Título + ▸ Sección activa) y botón ▾ */
    .header-scroll-pill {
      height: 44px;
      gap: 10px;
      padding: 4px 10px;
      font-size: clamp(0.92rem, 1.35vw, 1.05rem);
    }

    .header-scroll-pill__stack {
      align-items: flex-start;
      gap: 1px;
    }

    .header-scroll-pill__title {
      text-align: left;
      line-height: 1.15;
    }

    .header-scroll-pill__section {
      display: flex;
      align-items: center;
      gap: 4px;
      max-width: 100%;
      font-size: 0.74rem;
      font-weight: 600;
      color: #F4E8C1;
      opacity: 0.92;
      line-height: 1.15;
    }

    .header-scroll-pill__section .js-header-active-section {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .pill-icon-desktop {
      display: none;
    }

    .pill-icon-tablet {
      display: inline-block;
    }

    .header-scroll-pill:hover .header-scroll-pill__up {
      transform: none;
    }
  }

  /* Tablet compacta (769px - 1024px): botones solo icono para dar ancho holgado al centro */
  @media (max-width: 64rem) and (min-width: 769px) {
    .header-brand-group {
      gap: 8px;
    }
    .header-logos {
      gap: 6px;
    }
    .header-logos img {
      width: 38px;
      height: 38px;
    }
    .header-actions {
      gap: 6px;
    }
    .nav-btn-text {
      display: none;
    }
    .header-link-btn {
      width: 36px;
      height: 36px;
      padding: 0;
    }
    .menu-toggle {
      width: 36px;
      height: 36px;
    }
  }

  @media (max-width: 900px) and (min-width: 769px) {
    .brand-badge {
      display: none;
    }
    .brand-title {
      font-size: 1rem;
    }
  }

  /* ==========================================================================
     MÓVIL (≤ 768px): OPCIÓN B INTEGRADA EN LA CABECERA (RECUPERA 48 PX)
     ========================================================================== */
  @media (max-width: 768px) {
    .header-custom {
      gap: 6px;
    }
    .header-scroll-context {
      display: none;
    }
    .header-brand-group {
      gap: 7px;
      min-width: 0;
      flex: 1 1 auto;
      overflow: hidden;
    }
    .header-logos {
      gap: 4px;
      padding: 2px 5px;
      flex-shrink: 0;
      max-width: 84px;
      overflow: hidden;
    }
    .header-logos-sep {
      height: 16px;
    }
    .header-logos img {
      width: 32px;
      height: 32px;
      padding: 1px;
    }
    /* Al hacer scroll en móvil, los escudos se repliegan suavemente para dar ancho completo a la píldora de 2 líneas */
    :global(html[data-header-title='visible']) .header-logos {
      max-width: 0;
      padding-inline: 0;
      border-color: transparent;
      opacity: 0;
      transform: scale(0.8);
      pointer-events: none;
      margin-inline-end: -7px;
    }
    .brand-swap-slot {
      flex: 1 1 auto;
      min-width: 0;
      height: 40px;
      overflow: hidden;
    }
    .brand-default-layer {
      width: 100%;
      justify-content: space-between;
      gap: 6px;
      min-width: 0;
      overflow: hidden;
    }
    .header-brand {
      flex: 1 1 auto;
      min-width: 0;
      overflow: hidden;
    }
    .mobile-top-toc-trigger {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      flex-shrink: 0;
      height: 28px;
      padding: 0 9px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.14);
      border: 1px solid rgba(212, 175, 55, 0.48);
      color: #F4E8C1;
      font-family: inherit;
      font-size: 0.72rem;
      font-weight: 750;
      cursor: pointer;
    }
    .brand-mobile-title-btn {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      gap: 7px;
      width: 100%;
      padding: 2px 7px;
      box-sizing: border-box;
      border-radius: 9px;
      border: 1.5px solid rgba(212, 175, 55, 0.52);
      background: rgba(255, 255, 255, 0.14);
      color: #FFFFFF;
      font-family: inherit;
      text-align: left;
      cursor: pointer;
      opacity: 0;
      transform: translateY(105%);
      pointer-events: none;
      transition: transform 0.34s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.26s ease;
    }
    :global(:root[data-theme='dark']) .brand-mobile-title-btn {
      background: rgba(212, 175, 55, 0.14);
      border-color: rgba(212, 175, 55, 0.5);
      color: #F4E8C1;
    }
    .brand-mobile-title-stack {
      flex: 1 1 auto;
      min-width: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 1px;
    }
    .brand-mobile-title-text {
      min-width: 0;
      font-size: 0.84rem;
      font-weight: 800;
      line-height: 1.12;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .brand-mobile-section-line {
      display: flex;
      align-items: center;
      gap: 4px;
      min-width: 0;
      font-size: 0.7rem;
      font-weight: 650;
      line-height: 1.12;
      color: #F4E8C1;
      opacity: 0.92;
    }
    .brand-mobile-section-line .js-header-active-section {
      min-width: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .brand-mobile-title-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      width: 22px;
      height: 22px;
      border-radius: 6px;
      background: rgba(212, 175, 55, 0.2);
      border: 1px solid rgba(212, 175, 55, 0.38);
      color: #F4E8C1;
      font-size: 0.8rem;
      font-weight: 900;
    }
    :global(html[data-header-title='visible']) .brand-default-layer {
      transform: translateY(-105%);
      opacity: 0;
      pointer-events: none;
    }
    :global(html[data-header-title='visible']) .brand-mobile-title-btn {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }
    .brand-title {
      font-size: 0.94rem;
      letter-spacing: 0.2px;
    }
    .brand-subtitle,
    .nav-btn-text {
      display: none;
    }
    .menu-toggle {
      width: 34px;
      height: 34px;
      padding: 6px;
    }
    .menu-toggle .hamburger-bar {
      width: 17px;
      height: 2px;
    }
    .header-actions {
      gap: 5px;
      flex-shrink: 0;
    }
    .header-link-btn {
      width: 34px;
      height: 34px;
      padding: 0;
      justify-content: center;
    }
  }

  /* Evitar colisión de badge UPIICSA con Índice entre 541px y 620px */
  @media (max-width: 620px) {
    .brand-badge {
      display: none;
    }
  }

  /* Móvil estándar (≤ 540px): ocultar 🏠 redundante (escudos/título van a Inicio) para dar aire real */
  @media (max-width: 540px) {
    .header-custom {
      gap: 5px;
    }
    .header-brand-group {
      gap: 5px;
    }
    .header-logos {
      gap: 3px;
      padding: 2px 4px;
      max-width: 70px;
    }
    .header-logos-sep {
      height: 14px;
    }
    .header-logos img {
      width: 28px;
      height: 28px;
    }
    :global(html[data-header-title='visible']) .header-logos {
      margin-inline-end: -5px;
    }
    .brand-title {
      font-size: 0.86rem;
    }
    .mobile-top-toc-trigger {
      width: 28px;
      height: 28px;
      padding: 0;
    }
    .mobile-top-toc-trigger__label {
      display: none;
    }
    .brand-mobile-title-btn {
      padding: 2px 6px;
      gap: 5px;
    }
    .context-pill-badge--sm {
      font-size: 0.66rem;
      padding: 2px 5px;
    }
    .brand-mobile-title-text {
      font-size: 0.82rem;
    }
    .brand-mobile-section-line {
