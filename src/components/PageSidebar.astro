---
import MobileTableOfContents from 'virtual:starlight/components/MobileTableOfContents';
import TableOfContents from 'virtual:starlight/components/TableOfContents';
import { getUnitByPath, getUnitQuizHref } from '../config/units';

const { toc, sidebar, pagination, entry } = Astro.locals.starlightRoute;
const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Tiempo estimado de lectura (~200 palabras/min)
const rawBody = typeof entry?.body === 'string' ? entry.body : '';
const wordCount = rawBody
  .replace(/```[\s\S]*?```/g, ' ')
  .replace(/<[^>]+>/g, ' ')
  .replace(/[#*`>\[\]()_~|:-]/g, ' ')
  .trim()
  .split(/\s+/)
  .filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

// Contexto de unidad y progreso dentro de la unidad
const currentUnit = getUnitByPath(pathname);
const unitLabel = currentUnit?.label ?? '';
const unitShort = currentUnit?.short ?? '';
const quizHref = currentUnit ? getUnitQuizHref(currentUnit, base) : '';

type SidebarEntry = (typeof sidebar)[number];
function collectLinks(entries: SidebarEntry[]): Array<Extract<SidebarEntry, { type: 'link' }>> {
  const out: Array<Extract<SidebarEntry, { type: 'link' }>> = [];
  for (const e of entries) {
    if (e.type === 'link') out.push(e);
    else if (e.type === 'group') out.push(...collectLinks(e.entries));
  }
  return out;
}

let topicIndex = 0;
let topicTotal = 0;
for (const item of sidebar) {
  if (item.type === 'group') {
    const links = collectLinks(item.entries);
    const idx = links.findIndex((link) => link.isCurrent);
    if (idx !== -1) {
      topicIndex = idx + 1;
      topicTotal = links.length;
      break;
    }
  }
}

const unitPct = topicTotal > 0 ? Math.round((topicIndex / topicTotal) * 100) : 0;
const prevLink = pagination?.prev;
const nextLink = pagination?.next;
---

{
  toc && (
    <>
      <div class="lg:sl-hidden">
        <MobileTableOfContents />

        <!-- Pie contextual inyectado dentro del desplegable móvil/tablet (Opción B) -->
        <div id="mobileTocFooterSource" class="mobile-toc-footer" hidden>
          <div class="mobile-toc-footer__meta">
            <span>⏱ ~{readingMinutes} min</span>
            {unitLabel && topicTotal > 0 && (
              <span>
                {unitShort} · {topicIndex}/{topicTotal}
              </span>
            )}
            <span class="js-toc-pct-mirror">0 %</span>
          </div>
          <div class="mobile-toc-footer__actions">
            {quizHref && (
              <a href={quizHref} class="mobile-toc-quiz-btn">
                🥽 Cuestionario {unitShort}
              </a>
            )}
            <button type="button" class="mobile-toc-top-btn js-mobile-toc-top">
              ↑ Volver arriba
            </button>
          </div>
        </div>
      </div>

      <div class="right-sidebar-panel sl-hidden lg:sl-flex">
        <div class="sl-container toc-enhanced-shell">
          <!-- BLOQUE SUPERIOR: PROGRESO DE LECTURA + ÍNDICE DE SECCIONES -->
          <div class="toc-top-group">
            <div class="toc-reading-meta" aria-label="Información de lectura">
              <div class="toc-meta-row">
                <span class="toc-read-time">⏱ ~{readingMinutes} min</span>
                <span id="tocReadingPct" class="toc-read-pct">0 %</span>
              </div>
              <div class="toc-mini-track" aria-hidden="true">
                <div id="tocReadingBar" class="toc-mini-fill"></div>
              </div>
            </div>

            <div class="toc-sections-card">
              <TableOfContents />
            </div>
          </div>

          <!-- BLOQUE INFERIOR: CONTEXTO DE UNIDAD Y ATAJOS RÁPIDOS -->
          <div class="toc-context-card">
            {unitLabel && topicTotal > 0 && (
              <div class="toc-unit-progress">
                <div class="toc-unit-header">
                  <span class="toc-unit-badge">{unitShort}</span>
                  <span class="toc-unit-label">{unitLabel}</span>
                  <span class="toc-unit-count">
                    {topicIndex}/{topicTotal}
                  </span>
                </div>
                <div class="toc-unit-bar" aria-hidden="true">
                  <div class="toc-unit-bar__fill" style={`width: ${unitPct}%`}></div>
                </div>
              </div>
            )}

            {quizHref && (
              <a href={quizHref} class="toc-quiz-link" title={`Ir al cuestionario de ${unitLabel}`}>
                <span aria-hidden="true">🥽</span>
                <span>Cuestionario {unitShort}</span>
              </a>
            )}

            <div class="toc-quick-nav">
              {prevLink && (
                <a href={prevLink.href} class="toc-quick-btn" title={`Anterior: ${prevLink.label}`}>
                  ← Anterior
                </a>
              )}
              {nextLink && (
                <a href={nextLink.href} class="toc-quick-btn" title={`Siguiente: ${nextLink.label}`}>
                  Siguiente →
                </a>
              )}
              <button
                id="tocBackToTop"
                type="button"
                class="toc-quick-btn toc-quick-btn--top"
                title="Volver al inicio de la página"
              >
                ↑ Arriba
              </button>
            </div>
          </div>
        </div>
      </div>
    </>
  )
}

<script>
  let cleanupTocSync: (() => void) | null = null;

  function setupTocProgress() {
    if (cleanupTocSync) {
      cleanupTocSync();
      cleanupTocSync = null;
    }

    const pctEl = document.getElementById('tocReadingPct');
    const barEl = document.getElementById('tocReadingBar');
    const topBtn = document.getElementById('tocBackToTop');

    // Inyectar el pie contextual dentro del desplegable móvil/tablet (Opción B)
    const mobileFooterSource = document.getElementById('mobileTocFooterSource');
    const mobileDropdown = document.querySelector('mobile-starlight-toc .dropdown');
    if (mobileFooterSource && mobileDropdown && mobileFooterSource.parentElement !== mobileDropdown) {
      mobileFooterSource.hidden = false;
      mobileDropdown.appendChild(mobileFooterSource);
    }

    const mirrorPctEls = Array.from(document.querySelectorAll<HTMLElement>('.js-toc-pct-mirror'));
    const mobileTopBtn = document.querySelector<HTMLElement>('.js-mobile-toc-top');
    const mobileDetails = document.getElementById('starlight__mobile-toc') as HTMLDetailsElement | null;

    let rafId = 0;

    const update = () => {
      rafId = 0;
      const doc = document.documentElement;
      const maxScroll = doc.scrollHeight - window.innerHeight;
      const ratio = maxScroll > 20 ? Math.min(1, Math.max(0, window.scrollY / maxScroll)) : 0;
      const pct = Math.round(ratio * 100);
      if (pctEl) pctEl.textContent = `${pct} %`;
      mirrorPctEls.forEach((el) => {
        el.textContent = `${pct} %`;
      });
      if (barEl) barEl.style.transform = `scaleX(${ratio.toFixed(4)})`;
    };

    const schedule = () => {
      if (!rafId) rafId = window.requestAnimationFrame(update);
    };

    const scrollTop = () => {
      if (mobileDetails) mobileDetails.open = false;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
    };

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    topBtn?.addEventListener('click', scrollTop);
    mobileTopBtn?.addEventListener('click', scrollTop);
    update();

    cleanupTocSync = () => {
      if (rafId) window.cancelAnimationFrame(rafId);
      window.removeEventListener('scroll', schedule);
      window.removeEventListener('resize', schedule);
      topBtn?.removeEventListener('click', scrollTop);
      mobileTopBtn?.removeEventListener('click', scrollTop);
    };
  }

  setupTocProgress();
  document.addEventListener('astro:page-load', setupTocProgress);
</script>

<style>
  @layer starlight.core {
    .right-sidebar-panel {
      padding: 0.9rem 0.85rem;
      min-height: 100%;
      flex-direction: column;
      box-sizing: border-box;
    }

    .sl-container {
      width: 100%;
    }

    .right-sidebar-panel :global(h2) {
      color: var(--sl-color-white);
      font-size: 0.74rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.9px;
      line-height: 1.3;
      margin-bottom: 0.6rem;
    }

    .right-sidebar-panel :global(:where(a)) {
      display: block;
      font-size: 0.82rem;
      text-decoration: none;
      color: var(--sl-color-gray-3);
      overflow-wrap: anywhere;
    }

    .right-sidebar-panel :global(:where(a):hover) {
      color: var(--sl-color-white);
    }
  }

  .toc-enhanced-shell {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    flex: 1 1 auto;
  }

  .toc-top-group {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  /* Indicador compacto de lectura */
  .toc-reading-meta {
    padding: 0.65rem 0.75rem;
    border-radius: 12px;
    background: rgba(0, 100, 58, 0.06);
    border: 1px solid rgba(0, 100, 58, 0.16);
  }

  :global(:root[data-theme='dark']) .toc-reading-meta {
    background: rgba(10, 30, 20, 0.75);
    border-color: rgba(212, 175, 55, 0.24);
  }

  .toc-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.45rem;
    font-size: 0.76rem;
    font-weight: 700;
  }

  .toc-read-time {
    color: #334155;
  }

  :global(:root[data-theme='dark']) .toc-read-time {
    color: #B2C5BC;
  }

  .toc-read-pct {
    color: #00643A;
    font-variant-numeric: tabular-nums;
    font-weight: 800;
  }

  :global(:root[data-theme='dark']) .toc-read-pct {
    color: #D4AF37;
  }

  .toc-mini-track {
    width: 100%;
    height: 4px;
    border-radius: 999px;
    background: rgba(0, 100, 58, 0.14);
    overflow: hidden;
  }

  :global(:root[data-theme='dark']) .toc-mini-track {
    background: rgba(212, 175, 55, 0.18);
  }

  .toc-mini-fill {
    width: 100%;
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #00643A 0%, #D4AF37 100%);
    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
  }

  :global(:root[data-theme='dark']) .toc-mini-fill {
    background: linear-gradient(90deg, #D4AF37 0%, #F4E8C1 100%);
  }

  /* Tarjeta de índice de secciones con riel vertical activo */
  .toc-sections-card {
    padding: 0.75rem 0.7rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(0, 100, 58, 0.14);
  }

  :global(:root[data-theme='dark']) .toc-sections-card {
    background: rgba(10, 30, 20, 0.62);
    border-color: rgba(212, 175, 55, 0.22);
  }

  /* Tarjeta contextual inferior */
  .toc-context-card {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 0.8rem 0.75rem;
    border-radius: 12px;
    background: rgba(0, 100, 58, 0.05);
    border: 1px solid rgba(0, 100, 58, 0.16);
  }

  :global(:root[data-theme='dark']) .toc-context-card {
    background: rgba(10, 30, 20, 0.78);
    border-color: rgba(212, 175, 55, 0.24);
  }

  .toc-unit-progress {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .toc-unit-header {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.76rem;
    font-weight: 700;
  }

  .toc-unit-badge {
    background: #00643A;
    color: #FFFFFF;
    font-size: 0.66rem;
    font-weight: 900;
    padding: 2px 6px;
    border-radius: 5px;
    letter-spacing: 0.4px;
  }

  :global(:root[data-theme='dark']) .toc-unit-badge {
    background: #D4AF37;
    color: #00361F;
  }

  .toc-unit-label {
    color: #0F172A;
    flex: 1;
  }

  :global(:root[data-theme='dark']) .toc-unit-label {
    color: #F4E8C1;
  }

  .toc-unit-count {
    color: #00643A;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  :global(:root[data-theme='dark']) .toc-unit-count {
    color: #D4AF37;
  }

  .toc-unit-bar {
    width: 100%;
    height: 5px;
    border-radius: 999px;
    background: rgba(0, 100, 58, 0.14);
    overflow: hidden;
  }

  :global(:root[data-theme='dark']) .toc-unit-bar {
    background: rgba(212, 175, 55, 0.16);
  }

  .toc-unit-bar__fill {
    height: 100%;
    border-radius: 999px;
    background: #00643A;
    transition: width 0.3s ease;
  }

  :global(:root[data-theme='dark']) .toc-unit-bar__fill {
    background: #D4AF37;
  }

  .toc-quiz-link {
    display: flex !important;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.52rem 0.7rem;
    border-radius: 9px;
    background: linear-gradient(135deg, #00643A 0%, #004D2C 100%);
    border: 1.5px solid #D4AF37;
    color: #FFFFFF !important;
    font-size: 0.8rem !important;
    font-weight: 800;
    text-align: center;
    text-decoration: none !important;
    box-shadow: 0 4px 12px rgba(0, 100, 58, 0.22);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .toc-quiz-link:hover {
    background: linear-gradient(135deg, #D4AF37 0%, #B89628 100%);
    color: #00361F !important;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(212, 175, 55, 0.32);
  }

  .toc-quick-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem;
  }

  .toc-quick-btn {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    padding: 0.4rem 0.5rem;
    border-radius: 8px;
    font-size: 0.74rem !important;
    font-weight: 700;
    font-family: inherit;
    color: #1E293B !important;
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(0, 100, 58, 0.2);
    text-decoration: none !important;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  :global(:root[data-theme='dark']) .toc-quick-btn {
    color: #E2E8F0 !important;
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(212, 175, 55, 0.25);
  }

  .toc-quick-btn:hover {
    border-color: #00643A;
    color: #00643A !important;
    background: rgba(0, 100, 58, 0.08);
  }

  :global(:root[data-theme='dark']) .toc-quick-btn:hover {
    border-color: #D4AF37;
    color: #D4AF37 !important;
    background: rgba(212, 175, 55, 0.12);
  }

  .toc-quick-btn--top {
    grid-column: 1 / -1;
  }
</style>
