---
import { getQuizByUnit } from '../../data/cuestionarios';

interface Props {
  unit: number;
}

const { unit } = Astro.props;
const quiz = getQuizByUnit(unit);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const unitBackHref = unit === 1 ? `${base}/es/unidad-1/1-4-2-base-rv/` : `${base}/es/unidad-2/2-4-3-aplicaciones/`;
---

<div id="webxr-quiz-root" class="quiz-root" data-unit={unit}>
  <!-- OVERLAY DE DOM DURANTE LA SESIÓN AR MÓVIL -->
  <div id="ar-dom-overlay" class="ar-dom-overlay" style="display: none;">
    <div class="ar-hud-header">
      <div class="ar-hud-badge">
        <span class="hud-dot"></span>
        <span class="lang-es">Unidad {unit} • Modo RA Activo</span>
        <span class="lang-en" style="display: none;">Unit {unit} • AR Mode Active</span>
      </div>
      <button id="btn-exit-ar" class="btn-exit-ar" type="button" aria-label="Salir de Realidad Aumentada">
        ✕ <span class="lang-es">Salir de RA</span><span class="lang-en" style="display: none;">Exit AR</span>
      </button>
    </div>

    <!-- Indicador central de escena de prueba Fase 3 -->
    <div class="ar-hud-instructions">
      <p class="lang-es">📍 Objeto de prueba 3D anclado a 1.2 m frente a ti. Muévete libremente alrededor.</p>
      <p class="lang-en" style="display: none;">📍 3D test object anchored 1.2m in front of you. Move freely around it.</p>
    </div>
  </div>

  <!-- TARJETA PRINCIPAL DEL CUESTIONARIO -->
  <div class="quiz-card">
    <div class="quiz-header">
      <div class="unit-pill">
        <span class="pill-dot"></span>
        <span class="lang-es">Unidad Temática {unit}</span>
        <span class="lang-en" style="display: none;">Thematic Unit {unit}</span>
      </div>
      <h1 class="quiz-title">
        <span class="lang-es">{quiz?.titulo.es || `Cuestionario en RA — Unidad ${unit}`}</span>
        <span class="lang-en" style="display: none;">{quiz?.titulo.en || `AR Quiz — Unit ${unit}`}</span>
      </h1>
      <p class="quiz-desc">
        <span class="lang-es">{quiz?.descripcion.es || 'Evaluación interactiva inmersiva con tecnología WebXR.'}</span>
        <span class="lang-en" style="display: none;">{quiz?.descripcion.en || 'Immersive interactive assessment using WebXR technology.'}</span>
      </p>
    </div>

    <!-- VISOR 3D DIRECTO EN PANTALLA (Objeto de prueba interactivo visible en web) -->
    <div class="viewport-wrapper">
      <div class="viewport-header">
        <span class="viewport-badge">
          <span class="badge-dot"></span>
          <span class="lang-es">Escena 3D de Prueba (Fase 3)</span>
          <span class="lang-en" style="display: none;">3D Test Scene (Phase 3)</span>
        </span>
        <span class="viewport-hint">
          <span class="lang-es">Arrastra con el ratón o dedo para rotar</span>
          <span class="lang-en" style="display: none;">Drag with mouse or finger to rotate</span>
        </span>
      </div>
      <div id="quiz-3d-viewport" class="quiz-3d-viewport">
        <!-- El canvas Three.js se inserta aquí dinámicamente -->
      </div>
    </div>

    <!-- ESTADO 1: COMPROBANDO COMPATIBILIDAD CON RA -->
    <div id="quiz-state-checking" class="quiz-state-box">
      <div class="spinner"></div>
      <p class="lang-es">Verificando compatibilidad con Realidad Aumentada (WebXR)...</p>
      <p class="lang-en" style="display: none;">Checking Augmented Reality (WebXR) compatibility...</p>
    </div>

    <!-- ESTADO 2: DISPOSITIVO COMPATIBLE (BOTÓN PARA LANZAR CÁMARA AR) -->
    <div id="quiz-state-supported" class="quiz-state-box" style="display: none;">
      <div class="supported-banner">
        <div class="ar-icon-glow">🥽</div>
        <div class="supported-text">
          <h2 class="lang-es">¡Tu dispositivo es compatible con Realidad Aumentada!</h2>
          <h2 class="lang-en" style="display: none;">Your device supports Augmented Reality!</h2>
          <p class="lang-es">Pulsa el botón para abrir la cámara del móvil y proyectar el objeto 3D en tu espacio real.</p>
          <p class="lang-en" style="display: none;">Tap the button to open your mobile camera and project the 3D object into your real room.</p>
        </div>
      </div>

      <button id="btn-start-ar" class="btn-start-ar" type="button">
        <span class="btn-ar-icon">✨</span>
        <span class="lang-es">Proyectar en Realidad Aumentada (Cámara)</span>
        <span class="lang-en" style="display: none;">Project in Augmented Reality (Camera)</span>
      </button>

      <div class="ar-tips">
        <p class="tips-title">
          <span class="lang-es">💡 Recomendaciones para la sesión:</span>
          <span class="lang-en" style="display: none;">💡 Tips for the AR session:</span>
        </p>
        <ul>
          <li>
            <span class="lang-es">Asegúrate de contar con buena iluminación en la habitación.</span>
            <span class="lang-en" style="display: none;">Ensure the room has good lighting.</span>
          </li>
          <li>
            <span class="lang-es">Apunta el móvil hacia un espacio despejado frente a ti.</span>
            <span class="lang-en" style="display: none;">Point your phone at an open space in front of you.</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- ESTADO 3: DISPOSITIVO SIN SOPORTE AR (PC O MÓVIL SIN ARCORE) -->
    <div id="quiz-state-unsupported" class="quiz-state-box" style="display: none;">
      <div class="unsupported-banner">
        <div class="unsupported-icon">📱</div>
        <div class="unsupported-content">
          <h2 class="lang-es">Modo Cámara RA disponible en móvil compatible</h2>
          <h2 class="lang-en" style="display: none;">AR Camera Mode Available on Supported Mobile</h2>
          <p class="lang-es">
            Estás visualizando el objeto de prueba en <strong>3D interactivo en pantalla</strong>. Para proyectarlo mediante la cámara de tu habitación con Realidad Aumentada (<code>immersive-ar</code>), abre este enlace en un móvil <strong>Android con Google Chrome</strong> y <strong>ARCore</strong> por <strong>HTTPS</strong>.
          </p>
          <p class="lang-en" style="display: none;">
            You are viewing the test object in <strong>interactive on-screen 3D</strong>. To project it through your room camera using Augmented Reality (<code>immersive-ar</code>), open this link on an <strong>Android phone with Google Chrome</strong> and <strong>ARCore</strong> over <strong>HTTPS</strong>.
          </p>
        </div>
      </div>

      <button id="btn-recheck-ar" class="btn-secondary" type="button">
        🔄 <span class="lang-es">Volver a comprobar compatibilidad RA</span><span class="lang-en" style="display: none;">Recheck AR Compatibility</span>
      </button>
    </div>

    <!-- ESTADO 4: ERROR AL INICIAR LA SESIÓN AR -->
    <div id="quiz-state-error" class="quiz-state-box" style="display: none;">
      <div class="error-banner">
        <span class="error-icon">⚠️</span>
        <div>
          <h2 class="lang-es">No se pudo iniciar la sesión de Realidad Aumentada</h2>
          <h2 class="lang-en" style="display: none;">Could not start Augmented Reality session</h2>
          <p id="error-message-text" class="error-msg">Permiso de cámara denegado o sesión no soportada.</p>
        </div>
      </div>
      <button id="btn-retry-ar" class="btn-secondary" type="button">
        🔄 <span class="lang-es">Intentar de nuevo</span><span class="lang-en" style="display: none;">Try again</span>
      </button>
    </div>

    <!-- PIE DE LA TARJETA: VOLVER AL CONTENIDO -->
    <div class="quiz-footer">
      <a href={unitBackHref} class="back-link">
        ← <span class="lang-es">Regresar a los temas de la Unidad {unit}</span><span class="lang-en" style="display: none;">Back to Unit {unit} topics</span>
      </a>
    </div>
  </div>
</div>

<script>
  import * as THREE from 'three';

  function syncLanguageVisibility() {
    const isEn = localStorage.getItem('upiicsa_gt_lang') === 'en' ||
      document.documentElement.lang === 'en' ||
      (document.cookie.includes('googtrans=/es/en'));

    document.querySelectorAll('#webxr-quiz-root .lang-es').forEach(el => {
      (el as HTMLElement).style.display = isEn ? 'none' : '';
    });
    document.querySelectorAll('#webxr-quiz-root .lang-en').forEach(el => {
      (el as HTMLElement).style.display = isEn ? '' : 'none';
    });
  }

  class WebXRQuizController {
    private xrSession: XRSession | null = null;
    private renderer: THREE.WebGLRenderer | null = null;
    private scene: THREE.Scene | null = null;
    private camera: THREE.PerspectiveCamera | null = null;
    private testMesh: THREE.Mesh | null = null;
    private wireframeMesh: THREE.LineSegments | null = null;

    private viewportContainer = document.getElementById('quiz-3d-viewport');
    private stateChecking = document.getElementById('quiz-state-checking');
    private stateSupported = document.getElementById('quiz-state-supported');
    private stateUnsupported = document.getElementById('quiz-state-unsupported');
    private stateError = document.getElementById('quiz-state-error');
    private arDomOverlay = document.getElementById('ar-dom-overlay');
    private btnStartAR = document.getElementById('btn-start-ar');
    private btnExitAR = document.getElementById('btn-exit-ar');
    private btnRecheckAR = document.getElementById('btn-recheck-ar');
    private btnRetryAR = document.getElementById('btn-retry-ar');
    private errorText = document.getElementById('error-message-text');

    private isDragging = false;
    private previousMousePosition = { x: 0, y: 0 };
    private isARActive = false;

    constructor() {
      this.init3DScene();
      this.bindEvents();
      this.checkWebXRSupport();
    }

    private init3DScene() {
      if (!this.viewportContainer) return;

      const width = this.viewportContainer.clientWidth || 600;
      const height = this.viewportContainer.clientHeight || 320;

      // Crear escena y cámara
      this.scene = new THREE.Scene();
      this.camera = new THREE.PerspectiveCamera(50, width / height, 0.01, 20);
      this.camera.position.set(0, 0, 0.7);

      // Crear renderizador
      this.renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      this.renderer.setSize(width, height);
      this.viewportContainer.innerHTML = '';
      this.viewportContainer.appendChild(this.renderer.domElement);

      // Iluminación
      const ambientLight = new THREE.AmbientLight(0xffffff, 1.4);
      this.scene.add(ambientLight);

      const dirLight = new THREE.DirectionalLight(0xd4af37, 2.0);
      dirLight.position.set(1, 2, 1.5);
      this.scene.add(dirLight);

      const dirLight2 = new THREE.DirectionalLight(0x00643a, 1.5);
      dirLight2.position.set(-1, -1, 1);
      this.scene.add(dirLight2);

      // Objeto institucional de prueba: Dodecaedro Verde UPIICSA
      const geometry = new THREE.DodecahedronGeometry(0.18, 0);
      const material = new THREE.MeshStandardMaterial({
        color: 0x00643a,
        roughness: 0.25,
        metalness: 0.5,
        transparent: true,
        opacity: 0.92,
      });

      this.testMesh = new THREE.Mesh(geometry, material);
      this.testMesh.position.set(0, 0, 0);
      this.scene.add(this.testMesh);

      // Marco dorado poligonal exterior (wireframe)
      const wireframeGeo = new THREE.WireframeGeometry(geometry);
      const wireframeMat = new THREE.LineBasicMaterial({ color: 0xd4af37, linewidth: 2 });
      this.wireframeMesh = new THREE.LineSegments(wireframeGeo, wireframeMat);
      this.wireframeMesh.position.copy(this.testMesh.position);
      this.scene.add(this.wireframeMesh);

      // Bucle de animación continuo
      let clock = new THREE.Clock();
      this.renderer.setAnimationLoop(() => {
        const elapsedTime = clock.getElapsedTime();

        if (this.testMesh && this.wireframeMesh) {
          if (!this.isDragging) {
            this.testMesh.rotation.y += 0.008;
            this.testMesh.rotation.x = Math.sin(elapsedTime * 0.5) * 0.15;
          }

          if (this.isARActive) {
            this.testMesh.position.y = Math.sin(elapsedTime * 1.5) * 0.03;
          }

          this.wireframeMesh.rotation.copy(this.testMesh.rotation);
          this.wireframeMesh.position.copy(this.testMesh.position);
        }

        if (this.renderer && this.scene && this.camera) {
          this.renderer.render(this.scene, this.camera);
        }
      });

      // Controles táctiles / ratón en el visor 2D
      this.setupInteractiveControls();

      // Ajuste al redimensionar ventana
      window.addEventListener('resize', () => {
        if (!this.isARActive && this.viewportContainer && this.renderer && this.camera) {
          const w = this.viewportContainer.clientWidth;
          const h = this.viewportContainer.clientHeight || 320;
          this.camera.aspect = w / h;
          this.camera.updateProjectionMatrix();
          this.renderer.setSize(w, h);
        }
      });
    }

    private setupInteractiveControls() {
      const dom = this.renderer?.domElement;
      if (!dom) return;

      const onStart = (clientX: number, clientY: number) => {
        if (this.isARActive) return;
        this.isDragging = true;
        this.previousMousePosition = { x: clientX, y: clientY };
      };

      const onMove = (clientX: number, clientY: number) => {
        if (!this.isDragging || this.isARActive || !this.testMesh) return;
        const deltaX = clientX - this.previousMousePosition.x;
        const deltaY = clientY - this.previousMousePosition.y;

        this.testMesh.rotation.y += deltaX * 0.01;
        this.testMesh.rotation.x += deltaY * 0.01;

        this.previousMousePosition = { x: clientX, y: clientY };
      };

      const onEnd = () => {
        this.isDragging = false;
      };

      dom.addEventListener('mousedown', (e) => onStart(e.clientX, e.clientY));
      window.addEventListener('mousemove', (e) => onMove(e.clientX, e.clientY));
      window.addEventListener('mouseup', onEnd);

      dom.addEventListener('touchstart', (e) => {
        if (e.touches.length === 1) onStart(e.touches[0].clientX, e.touches[0].clientY);
      }, { passive: true });
      window.addEventListener('touchmove', (e) => {
        if (e.touches.length === 1) onMove(e.touches[0].clientX, e.touches[0].clientY);
      }, { passive: true });
      window.addEventListener('touchend', onEnd);
    }

    private bindEvents() {
      this.btnStartAR?.addEventListener('click', () => this.startARSession());
      this.btnExitAR?.addEventListener('click', () => this.endARSession());
      this.btnRecheckAR?.addEventListener('click', () => this.checkWebXRSupport());
      this.btnRetryAR?.addEventListener('click', () => this.checkWebXRSupport());

      window.addEventListener('storage', (e) => {
        if (e.key === 'upiicsa_gt_lang') syncLanguageVisibility();
      });
      document.addEventListener('astro:page-load', () => syncLanguageVisibility());
    }

    private showState(state: 'checking' | 'supported' | 'unsupported' | 'error', errorMsg?: string) {
      if (this.stateChecking) this.stateChecking.style.display = state === 'checking' ? 'flex' : 'none';
      if (this.stateSupported) this.stateSupported.style.display = state === 'supported' ? 'block' : 'none';
      if (this.stateUnsupported) this.stateUnsupported.style.display = state === 'unsupported' ? 'block' : 'none';
      if (this.stateError) {
        this.stateError.style.display = state === 'error' ? 'block' : 'none';
        if (errorMsg && this.errorText) this.errorText.textContent = errorMsg;
      }
      syncLanguageVisibility();
    }

    public async checkWebXRSupport() {
      this.showState('checking');

      if (!('xr' in navigator) || !navigator.xr) {
        this.showState('unsupported');
        return;
      }

      try {
        const isSupported = await navigator.xr.isSessionSupported('immersive-ar');
        if (isSupported) {
          this.showState('supported');
        } else {
          this.showState('unsupported');
        }
      } catch (err) {
        console.warn('[WebXR] Error comprobando soporte:', err);
        this.showState('unsupported');
      }
    }

    private async startARSession() {
      if (!navigator.xr || !this.renderer) return;

      try {
        const sessionInit: XRSessionInit = {
          requiredFeatures: ['local'],
          optionalFeatures: ['dom-overlay', 'hit-test', 'local-floor'],
        };

        if (this.arDomOverlay) {
          sessionInit.domOverlay = { root: this.arDomOverlay };
        }

        const session = await navigator.xr.requestSession('immersive-ar', sessionInit);
        this.onSessionStarted(session);
      } catch (err: any) {
        console.error('[WebXR] Fallo al iniciar sesión AR:', err);
        const msg = err?.message || 'Permiso de cámara denegado o error de inicialización en el dispositivo.';
        this.showState('error', msg);
      }
    }

    private async onSessionStarted(session: XRSession) {
      this.xrSession = session;
      this.isARActive = true;
      session.addEventListener('end', () => this.onSessionEnded());

      if (this.arDomOverlay) {
        this.arDomOverlay.style.display = 'flex';
      }

      if (!this.renderer) return;

      this.renderer.xr.enabled = true;
      this.renderer.xr.setReferenceSpaceType('local');
      await this.renderer.xr.setSession(session);

      // En AR, posicionamos el objeto a 1.2 metros al frente
      if (this.testMesh && this.wireframeMesh) {
        this.testMesh.position.set(0, 0, -1.2);
        this.wireframeMesh.position.copy(this.testMesh.position);
      }
    }

    private endARSession() {
      if (this.xrSession) {
        this.xrSession.end().catch(() => {});
      }
    }

    private onSessionEnded() {
      this.isARActive = false;
      this.xrSession = null;

      if (this.arDomOverlay) {
        this.arDomOverlay.style.display = 'none';
      }

      if (this.renderer) {
        this.renderer.xr.enabled = false;
        if (this.viewportContainer) {
          const w = this.viewportContainer.clientWidth || 600;
          const h = this.viewportContainer.clientHeight || 320;
          this.renderer.setSize(w, h);
          if (this.camera) {
            this.camera.aspect = w / h;
            this.camera.position.set(0, 0, 0.7);
            this.camera.updateProjectionMatrix();
          }
        }
      }

      if (this.testMesh && this.wireframeMesh) {
        this.testMesh.position.set(0, 0, 0);
        this.wireframeMesh.position.copy(this.testMesh.position);
      }

      this.showState('supported');
    }
  }

  function initWebXR() {
    syncLanguageVisibility();
    new WebXRQuizController();
  }

  initWebXR();
  document.addEventListener('astro:page-load', initWebXR);
</script>

<style>
  .quiz-root {
    width: 100%;
    max-width: 860px;
    margin: 1.5rem auto 3rem auto;
    font-family: inherit;
  }

  .quiz-card {
    background: linear-gradient(135deg, rgba(0, 100, 58, 0.05) 0%, rgba(212, 175, 55, 0.03) 100%);
    border: 1px solid rgba(212, 175, 55, 0.35);
    border-radius: 16px;
    padding: 2.2rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    box-sizing: border-box;
  }

  :root[data-theme='dark'] .quiz-card {
    background: linear-gradient(135deg, rgba(11, 20, 16, 0.95) 0%, rgba(6, 23, 14, 0.85) 100%);
    border-color: rgba(212, 175, 55, 0.4);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.35);
  }

  .quiz-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .unit-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(0, 100, 58, 0.15);
    color: #00643A;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 20px;
    border: 1px solid rgba(0, 100, 58, 0.3);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  :root[data-theme='dark'] .unit-pill {
    background: rgba(212, 175, 55, 0.15);
    color: #D4AF37;
    border-color: rgba(212, 175, 55, 0.35);
  }

  .pill-dot {
    width: 8px;
    height: 8px;
    background: #D4AF37;
    border-radius: 50%;
  }

  .quiz-title {
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--sl-color-text);
    margin: 0.5rem 0;
    line-height: 1.25;
  }

  .quiz-desc {
    font-size: 1.05rem;
    color: var(--sl-color-gray-2);
    max-width: 620px;
    margin: 0 auto;
  }

  /* VISOR 3D DIRECTO EN PANTALLA */
  .viewport-wrapper {
    margin: 1.5rem 0 2rem 0;
    background: radial-gradient(circle at center, rgba(0, 100, 58, 0.15) 0%, rgba(10, 20, 15, 0.9) 100%);
    border: 2px solid rgba(212, 175, 55, 0.45);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.25), inset 0 0 30px rgba(0, 100, 58, 0.2);
  }

  .viewport-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 16px;
    background: rgba(0, 0, 0, 0.4);
    border-bottom: 1px solid rgba(212, 175, 55, 0.25);
    font-size: 0.8rem;
  }

  .viewport-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #D4AF37;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    background: #10B981;
    border-radius: 50%;
  }

  .viewport-hint {
    color: var(--sl-color-gray-3);
    font-size: 0.78rem;
  }

  .quiz-3d-viewport {
    width: 100%;
    height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: grab;
    touch-action: none;
  }

  .quiz-3d-viewport:active {
    cursor: grabbing;
  }

  .quiz-state-box {
    margin: 1rem 0 1.5rem 0;
    padding: 1.5rem;
    border-radius: 12px;
    box-sizing: border-box;
  }

  /* Estado Checking */
  #quiz-state-checking {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px dashed rgba(212, 175, 55, 0.4);
    color: var(--sl-color-gray-2);
    font-weight: 600;
  }

  .spinner {
    width: 36px;
    height: 36px;
    border: 3px solid rgba(212, 175, 55, 0.2);
    border-top-color: #D4AF37;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Estado Compatible */
  .supported-banner {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    background: rgba(0, 100, 58, 0.1);
    border: 1px solid rgba(0, 100, 58, 0.3);
    padding: 1.2rem;
    border-radius: 12px;
    margin-bottom: 1.5rem;
  }

  :root[data-theme='dark'] .supported-banner {
    background: rgba(16, 185, 129, 0.08);
    border-color: rgba(16, 185, 129, 0.3);
  }

