---
import { getQuizByUnit } from '../../data/cuestionarios';

interface Props {
  unit: number;
}

const { unit } = Astro.props;
const quiz = getQuizByUnit(unit);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const unitBackHref = unit === 1 ? `${base}/es/unidad-1/1-4-2-base-rv/` : `${base}/es/unidad-2/2-4-3-aplicaciones/`;
---

<div id="webxr-quiz-root" class="quiz-root" data-unit={unit}>
  <!-- Inyección de datos validados del cuestionario -->
  <script id="quiz-data-json" type="application/json" set:html={JSON.stringify(quiz)} />

  <!-- OVERLAY DE DOM DURANTE LA SESIÓN AR MÓVIL -->
  <div id="ar-dom-overlay" class="ar-dom-overlay" style="display: none;">
    <!-- Plano transparente para capturar toques en cualquier zona de la pantalla -->
    <div id="ar-touch-plane" class="ar-touch-plane" aria-hidden="true"></div>

    <!-- Barra superior del HUD en RA -->
    <div class="ar-hud-header">
      <div class="ar-hud-badge">
        <span class="hud-dot"></span>
        <span class="lang-es">Unidad {unit} • RA Activo</span>
        <span class="lang-en" style="display: none;">Unit {unit} • AR Active</span>
      </div>

      <div id="ar-hud-score-pill" class="ar-hud-score-pill">
        <span id="hud-progress-text">P 1 / 5</span>
        <span class="score-divider">•</span>
        <span id="hud-score-text">Aciertos: 0</span>
      </div>

      <button id="btn-exit-ar" class="btn-exit-ar" type="button" aria-label="Salir de Realidad Aumentada">
        ✕ <span class="lang-es">Salir</span><span class="lang-en" style="display: none;">Exit</span>
      </button>
    </div>

    <!-- Modal de Resultados en AR cuando termina el cuestionario -->
    <div id="ar-results-modal" class="ar-results-modal" style="display: none;">
      <div class="results-card">
        <div class="results-trophy">🏆</div>
        <h2 class="results-title">
          <span class="lang-es">¡Cuestionario Completado!</span>
          <span class="lang-en" style="display: none;">Quiz Completed!</span>
        </h2>
        <div id="hud-results-score" class="results-score-badge">5 / 5 (100%)</div>
        <p id="hud-results-feedback" class="results-feedback-text">
          ¡Excelente comprensión de los temas de la unidad!
        </p>
        <div class="results-actions">
          <button id="btn-results-retry" class="btn-results-retry" type="button">
            🔄 <span class="lang-es">Reintentar cuestionario</span>
            <span class="lang-en" style="display: none;">Retry quiz</span>
          </button>
          <button id="btn-results-exit" class="btn-results-exit" type="button">
            ✕ <span class="lang-es">Salir de RA</span>
            <span class="lang-en" style="display: none;">Exit AR</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Controles inferiores en RA: telemetría en vivo, centrado inmediato y guía -->
    <div class="ar-hud-bottom">
      <div id="ar-status-pill" class="ar-status-pill">
        <span class="ar-status-dot"></span>
        <span id="ar-status-text">Iniciando rastreo 3D...</span>
      </div>
      <button id="btn-recenter-ar" class="btn-recenter-ar" type="button">
        🎯 <span class="lang-es">Centrar preguntas frente a mí</span>
        <span class="lang-en" style="display: none;">Center questions in front of me</span>
      </button>
      <div class="ar-hud-instructions">
        <p class="lang-es">👆 Toca una opción (A, B, C, D) para responder. Toca el fondo vacío para recentrar el cuestionario.</p>
        <p class="lang-en" style="display: none;">👆 Tap an option (A, B, C, D) to answer. Tap empty space to recenter the quiz.</p>
      </div>
    </div>
  </div>

  <!-- TARJETA PRINCIPAL DEL CUESTIONARIO EN LA PÁGINA -->
  <div class="quiz-card">
    <div class="quiz-header">
      <div class="unit-pill">
        <span class="pill-dot"></span>
        <span class="lang-es">Unidad Temática {unit}</span>
        <span class="lang-en" style="display: none;">Thematic Unit {unit}</span>
      </div>
      <h1 class="quiz-title">
        <span class="lang-es">{quiz?.titulo.es || `Cuestionario en RA — Unidad ${unit}`}</span>
        <span class="lang-en" style="display: none;">{quiz?.titulo.en || `AR Quiz — Unit ${unit}`}</span>
      </h1>
      <p class="quiz-desc">
        <span class="lang-es">{quiz?.descripcion.es || 'Evaluación interactiva inmersiva con tecnología WebXR.'}</span>
        <span class="lang-en" style="display: none;">{quiz?.descripcion.en || 'Immersive interactive assessment using WebXR technology.'}</span>
      </p>
    </div>

    <!-- ESTADO 1: COMPROBANDO COMPATIBILIDAD CON RA -->
    <div id="quiz-state-checking" class="quiz-state-box">
      <div class="spinner"></div>
      <p class="lang-es">Verificando compatibilidad con Realidad Aumentada (WebXR)...</p>
      <p class="lang-en" style="display: none;">Checking Augmented Reality (WebXR) compatibility...</p>
    </div>

    <!-- ESTADO 2: DISPOSITIVO COMPATIBLE (BOTÓN PARA LANZAR CÁMARA AR) -->
    <div id="quiz-state-supported" class="quiz-state-box" style="display: none;">
      <div class="supported-banner">
        <div class="ar-icon-glow">🥽</div>
        <div class="supported-text">
          <h2 class="lang-es">¡Tu dispositivo es compatible con Realidad Aumentada!</h2>
          <h2 class="lang-en" style="display: none;">Your device supports Augmented Reality!</h2>
          <p class="lang-es">Pulsa el botón para abrir la cámara del móvil y proyectar el cuestionario interactivo 3D en tu espacio físico.</p>
          <p class="lang-en" style="display: none;">Tap the button to open your mobile camera and project the interactive 3D quiz into your physical room.</p>
        </div>
      </div>

      <button id="btn-start-ar" class="btn-start-ar" type="button">
        <span class="btn-ar-icon">✨</span>
        <span class="lang-es">Proyectar Cuestionario en Realidad Aumentada</span>
        <span class="lang-en" style="display: none;">Project Quiz in Augmented Reality</span>
      </button>

      <div class="ar-tips">
        <p class="tips-title">
          <span class="lang-es">💡 Instrucciones para la sesión interactiva:</span>
          <span class="lang-en" style="display: none;">💡 Instructions for the interactive session:</span>
        </p>
        <ul>
          <li>
            <span class="lang-es">Asegúrate de contar con buena iluminación y apuntar hacia una mesa o espacio abierto.</span>
            <span class="lang-en" style="display: none;">Ensure good lighting and point towards a table or open area.</span>
          </li>
          <li>
            <span class="lang-es">Verás el panel de preguntas y 4 opciones flotantes (A, B, C, D). Toca la opción correcta directamente en tu pantalla.</span>
            <span class="lang-en" style="display: none;">You will see the question board and 4 floating cards (A, B, C, D). Tap the correct card right on your screen.</span>
          </li>
          <li>
            <span class="lang-es">Recibirás retroalimentación multisensorial en tiempo real (sonido, vibración háptica y animación 3D).</span>
            <span class="lang-en" style="display: none;">You will receive real-time multi-sensory feedback (sound, haptic vibration, and 3D animations).</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- ESTADO 3: DISPOSITIVO SIN SOPORTE AR (PC O MÓVIL SIN ARCORE) -->
    <div id="quiz-state-unsupported" class="quiz-state-box" style="display: none;">
      <div class="unsupported-banner">
        <div class="unsupported-icon">📱</div>
        <div class="unsupported-content">
          <h2 class="lang-es">Modo Realidad Aumentada disponible en móvil compatible</h2>
          <h2 class="lang-en" style="display: none;">Augmented Reality Mode Available on Supported Mobile</h2>
          <p class="lang-es">
            Para vivir la experiencia de evaluación inmersiva con preguntas flotantes en tu habitación mediante Realidad Aumentada (<code>immersive-ar</code>), abre este enlace en un móvil <strong>Android con Google Chrome</strong> y <strong>Servicios de Google Play para RA (ARCore)</strong> por <strong>HTTPS</strong>.
          </p>
          <p class="lang-en" style="display: none;">
            To experience the immersive assessment with floating 3D questions in your room via Augmented Reality (<code>immersive-ar</code>), open this page on an <strong>Android phone with Google Chrome</strong> and <strong>Google Play Services for AR (ARCore)</strong> over <strong>HTTPS</strong>.
          </p>
        </div>
      </div>

      <button id="btn-recheck-ar" class="btn-secondary" type="button">
        🔄 <span class="lang-es">Volver a comprobar compatibilidad RA</span><span class="lang-en" style="display: none;">Recheck AR Compatibility</span>
      </button>
    </div>

    <!-- ESTADO 4: ERROR AL INICIAR LA SESIÓN AR -->
    <div id="quiz-state-error" class="quiz-state-box" style="display: none;">
      <div class="error-banner">
        <span class="error-icon">⚠️</span>
        <div>
          <h2 class="lang-es">No se pudo iniciar la sesión de Realidad Aumentada</h2>
          <h2 class="lang-en" style="display: none;">Could not start Augmented Reality session</h2>
          <p id="error-message-text" class="error-msg">Permiso de cámara denegado o sesión no soportada.</p>
        </div>
      </div>
      <button id="btn-retry-ar" class="btn-secondary" type="button">
        🔄 <span class="lang-es">Intentar de nuevo</span><span class="lang-en" style="display: none;">Try again</span>
      </button>
    </div>

    <!-- PIE DE LA TARJETA: VOLVER AL CONTENIDO -->
    <div class="quiz-footer">
      <a href={unitBackHref} class="back-link">
        ← <span class="lang-es">Regresar a los temas de la Unidad {unit}</span><span class="lang-en" style="display: none;">Back to Unit {unit} topics</span>
      </a>
    </div>
  </div>
</div>

<script>
  import * as THREE from 'three';

  interface Question {
    id: string;
    unidad: number;
    tema: string;
    nivel: string;
    pendiente?: boolean;
    enunciado: { es: string; en: string };
    opciones: Array<{ es: string; en: string }>;
    respuestaCorrecta: number;
    explicacion: { es: string; en: string };
  }

  interface QuizData {
    unidad: number;
    titulo: { es: string; en: string };
    descripcion: { es: string; en: string };
    estado: string;
    preguntas: Question[];
  }

  function getCurrentLang(): 'es' | 'en' {
    const isEn = localStorage.getItem('upiicsa_gt_lang') === 'en' ||
      document.documentElement.lang === 'en' ||
      document.cookie.includes('googtrans=/es/en');
    return isEn ? 'en' : 'es';
  }

  function syncLanguageVisibility() {
    const isEn = getCurrentLang() === 'en';
    document.querySelectorAll('#webxr-quiz-root .lang-es').forEach(el => {
      (el as HTMLElement).style.display = isEn ? 'none' : '';
    });
    document.querySelectorAll('#webxr-quiz-root .lang-en').forEach(el => {
      (el as HTMLElement).style.display = isEn ? '' : 'none';
    });
  }

  // SINTETIZADOR DE AUDIO MULTISENSORIAL MEDIANTE WEB AUDIO API (CERO ARCHIVOS EXTERNOS)
  class SoundFX {
    private ctx: AudioContext | null = null;

    public init() {
      try {
        if (!this.ctx) {
          const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
          if (AudioContextClass) this.ctx = new AudioContextClass();
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      } catch {}
    }

    public playCorrect() {
      this.init();
      if (!this.ctx) return;
      try {
        const now = this.ctx.currentTime;
        // Acorde armónico ascendente: C5 (523.25 Hz), E5 (659.25 Hz), G5 (783.99 Hz)
        const notes = [523.25, 659.25, 783.99];
        notes.forEach((freq, idx) => {
          const osc = this.ctx!.createOscillator();
          const gain = this.ctx!.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(freq, now + idx * 0.08);
          gain.gain.setValueAtTime(0.25, now + idx * 0.08);
          gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.08 + 0.32);
          osc.connect(gain);
          gain.connect(this.ctx!.destination);
          osc.start(now + idx * 0.08);
          osc.stop(now + idx * 0.08 + 0.33);
        });
      } catch {}
    }

    public playIncorrect() {
      this.init();
      if (!this.ctx) return;
      try {
        const now = this.ctx.currentTime;
        // Tono grave descendente con onda tipo sierra
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(155, now);
        osc.frequency.exponentialRampToValueAtTime(100, now + 0.32);
        gain.gain.setValueAtTime(0.20, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.32);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(now);
        osc.stop(now + 0.33);
      } catch {}
    }

    public playFanfare() {
      this.init();
      if (!this.ctx) return;
      try {
        const now = this.ctx.currentTime;
        // Fanfarria celebratoria: C5 -> E5 -> G5 -> C6
        const chord = [523.25, 659.25, 783.99, 1046.50];
        chord.forEach((freq, idx) => {
          const osc = this.ctx!.createOscillator();
          const gain = this.ctx!.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, now + idx * 0.10);
          gain.gain.setValueAtTime(0.26, now + idx * 0.10);
          gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.10 + 0.55);
          osc.connect(gain);
          gain.connect(this.ctx!.destination);
          osc.start(now + idx * 0.10);
          osc.stop(now + idx * 0.10 + 0.58);
        });
      } catch {}
    }
  }

  // DIBUJO PROCEDURAL EN CANVAS 2D DE ALTA DEFINICIÓN
  function drawRoundedRect(
    ctx: CanvasRenderingContext2D,
    x: number,
    y: number,
    w: number,
    h: number,
    r: number
  ) {
    if (typeof ctx.roundRect === 'function') {
      ctx.beginPath();
      ctx.roundRect(x, y, w, h, r);
      ctx.closePath();
    } else {
      ctx.beginPath();
      ctx.moveTo(x + r, y);
      ctx.lineTo(x + w - r, y);
      ctx.quadraticCurveTo(x + w, y, x + w, y + r);
      ctx.lineTo(x + w, y + h - r);
      ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
      ctx.lineTo(x + r, y + h);
      ctx.quadraticCurveTo(x, y + h, x, y + h - r);
      ctx.lineTo(x, y + r);
      ctx.quadraticCurveTo(x, y, x + r, y);
      ctx.closePath();
    }
  }

  function wrapTextLines(
    ctx: CanvasRenderingContext2D,
    text: string,
    x: number,
    y: number,
    maxWidth: number,
    lineHeight: number,
    maxLines: number = 4
  ): number {
    const words = text.split(' ');
    let line = '';
    const lines: string[] = [];

    for (let n = 0; n < words.length; n++) {
      const testLine = line + words[n] + ' ';
      const metrics = ctx.measureText(testLine);
      if (metrics.width > maxWidth && n > 0) {
        lines.push(line.trim());
        line = words[n] + ' ';
      } else {
        line = testLine;
      }
    }
    lines.push(line.trim());

    const finalLines = lines.length > maxLines ? lines.slice(0, maxLines) : lines;
    if (lines.length > maxLines) {
      finalLines[maxLines - 1] += '...';
    }

    finalLines.forEach((l, i) => {
      ctx.fillText(l, x, y + i * lineHeight);
    });
    return finalLines.length;
  }

  class WebXRQuizController {
    private xrSession: XRSession | null = null;
    private renderer: THREE.WebGLRenderer | null = null;
    private scene: THREE.Scene | null = null;
    private camera: THREE.PerspectiveCamera | null = null;
    private controller: THREE.Group | null = null;
    private raycaster: THREE.Raycaster = new THREE.Raycaster();

    // Jerarquía 3D del cuestionario
    private objectAnchor: THREE.Group | null = null;
    private quizGroup: THREE.Group | null = null;
    private questionMesh: THREE.Mesh | null = null;
    private questionCanvas: HTMLCanvasElement | null = null;
    private questionTexture: THREE.CanvasTexture | null = null;

    private optionMeshes: THREE.Mesh[] = [];
    private optionCanvases: HTMLCanvasElement[] = [];
    private optionTextures: THREE.CanvasTexture[] = [];

    private resultsMesh: THREE.Mesh | null = null;
    private resultsCanvas: HTMLCanvasElement | null = null;
    private resultsTexture: THREE.CanvasTexture | null = null;

    private ring1: THREE.Mesh | null = null;
    private ring2: THREE.Mesh | null = null;

    // Estado del cuestionario
    private quizData: QuizData | null = null;
    private currentIndex = 0;
    private score = 0;
    private isLocked = false;
    private isComplete = false;
    private feedbackState: { isCorrect: boolean } | null = null;
    private soundFX = new SoundFX();
    private lastInteractionTime = 0;

    // Elementos DOM
    private stateChecking = document.getElementById('quiz-state-checking');
    private stateSupported = document.getElementById('quiz-state-supported');
    private stateUnsupported = document.getElementById('quiz-state-unsupported');
    private stateError = document.getElementById('quiz-state-error');
    private arDomOverlay = document.getElementById('ar-dom-overlay');
    private btnStartAR = document.getElementById('btn-start-ar');
    private btnExitAR = document.getElementById('btn-exit-ar');
    private btnRecenterAR = document.getElementById('btn-recenter-ar');
    private btnRecheckAR = document.getElementById('btn-recheck-ar');
    private btnRetryAR = document.getElementById('btn-retry-ar');
    private statusText = document.getElementById('ar-status-text');
    private errorText = document.getElementById('error-message-text');

    private hudProgressText = document.getElementById('hud-progress-text');
    private hudScoreText = document.getElementById('hud-score-text');
    private arResultsModal = document.getElementById('ar-results-modal');
    private hudResultsScore = document.getElementById('hud-results-score');
    private hudResultsFeedback = document.getElementById('hud-results-feedback');
    private btnResultsRetry = document.getElementById('btn-results-retry');
    private btnResultsExit = document.getElementById('btn-results-exit');

    private isARActive = false;
    private frameCount = 0;
    private unitNumber = Number(document.getElementById('webxr-quiz-root')?.getAttribute('data-unit') || 1);

    constructor() {
      this.loadQuizData();
      this.init3DScene();
      this.bindEvents();
      this.checkWebXRSupport();
    }

    private loadQuizData() {
      try {
        const raw = document.getElementById('quiz-data-json')?.textContent;
        if (raw) {
          this.quizData = JSON.parse(raw);
        }
      } catch (err) {
        console.warn('[WebXR] Error parseando datos del cuestionario:', err);
      }
    }

    private init3DScene() {
      const width = window.innerWidth || 800;
      const height = window.innerHeight || 600;

      this.scene = new THREE.Scene();
      this.camera = new THREE.PerspectiveCamera(50, width / height, 0.01, 25);
      this.camera.position.set(0, 0, 0.95);

      this.renderer = new THREE.WebGLRenderer({
        antialias: true,
        alpha: true,
        powerPreference: 'high-performance'
      });
      this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      this.renderer.setSize(width, height);
      this.renderer.setClearColor(0x000000, 0);
      this.renderer.xr.enabled = true;
      this.renderer.domElement.style.display = 'none';
      document.body.appendChild(this.renderer.domElement);

      this.controller = this.renderer.xr.getController(0);
      this.controller.addEventListener('select', () => this.onControllerSelect());
      this.scene.add(this.controller);

      // Iluminación espacial
      const ambientLight = new THREE.AmbientLight(0xffffff, 2.5);
      this.scene.add(ambientLight);

      const dirLight = new THREE.DirectionalLight(0xffffff, 2.0);
      dirLight.position.set(1.5, 3, 2);
      this.scene.add(dirLight);

      const dirLightGold = new THREE.DirectionalLight(0xd4af37, 1.8);
      dirLightGold.position.set(-1.5, -1, 1.5);
      this.scene.add(dirLightGold);

      // ANCLA PRINCIPAL DEL CUESTIONARIO
      this.objectAnchor = new THREE.Group();
      this.objectAnchor.position.set(0, 0, -0.80);
      this.scene.add(this.objectAnchor);

      // GRUPO DE PREGUNTAS Y OPCIONES
      this.quizGroup = new THREE.Group();
      this.objectAnchor.add(this.quizGroup);

      // 1. PANEL DE PREGUNTA CENTRAL (Superior)
      this.questionCanvas = document.createElement('canvas');
      this.questionCanvas.width = 1024;
      this.questionCanvas.height = 540;
      this.questionTexture = new THREE.CanvasTexture(this.questionCanvas);
      this.questionTexture.minFilter = THREE.LinearMipmapLinearFilter;
      this.questionTexture.generateMipmaps = true;

      const qGeo = new THREE.PlaneGeometry(0.74, 0.39);
      const qMat = new THREE.MeshBasicMaterial({
        map: this.questionTexture,
        transparent: true,
        side: THREE.DoubleSide
      });
      this.questionMesh = new THREE.Mesh(qGeo, qMat);
      this.questionMesh.position.set(0, 0.23, 0);
      this.quizGroup.add(this.questionMesh);

      // 2. 4 TARJETAS DE OPCIONES FLOTANTES EN ARCO/CABINA (2x2 Ergonómico para móviles)
      const optionGeo = new THREE.PlaneGeometry(0.44, 0.16);
      const cardPositions = [
        { x: -0.24, y: -0.04, z: 0.02, rotY: 0.08 },
        { x:  0.24, y: -0.04, z: 0.02, rotY: -0.08 },
        { x: -0.24, y: -0.22, z: 0.02, rotY: 0.08 },
        { x:  0.24, y: -0.22, z: 0.02, rotY: -0.08 }
      ];

      for (let i = 0; i < 4; i++) {
        const canvas = document.createElement('canvas');
        canvas.width = 512;
        canvas.height = 186;
        const texture = new THREE.CanvasTexture(canvas);
        texture.minFilter = THREE.LinearMipmapLinearFilter;
        texture.generateMipmaps = true;

        this.optionCanvases.push(canvas);
        this.optionTextures.push(texture);

        const mat = new THREE.MeshBasicMaterial({
          map: texture,
          transparent: true,
          side: THREE.DoubleSide
        });
        const mesh = new THREE.Mesh(optionGeo, mat);
        const pos = cardPositions[i];
        mesh.position.set(pos.x, pos.y, pos.z);
        mesh.rotation.y = pos.rotY;
        mesh.userData = { optionIndex: i };

        this.optionMeshes.push(mesh);
        this.quizGroup.add(mesh);
      }

      // 3. ANILLOS ORBITALES DECORATIVOS INSTITUCIONALES (UPIICSA Gold)
      const ringGeo1 = new THREE.TorusGeometry(0.48, 0.008, 16, 64);
      const ringMat1 = new THREE.MeshBasicMaterial({ color: 0xffd700, transparent: true, opacity: 0.7 });
      this.ring1 = new THREE.Mesh(ringGeo1, ringMat1);
      this.ring1.rotation.x = Math.PI / 2.2;
      this.ring1.position.set(0, -0.32, -0.04);
      this.quizGroup.add(this.ring1);

      const ringGeo2 = new THREE.TorusGeometry(0.52, 0.006, 16, 64);
      const ringMat2 = new THREE.MeshBasicMaterial({ color: 0x10b981, transparent: true, opacity: 0.5 });
      this.ring2 = new THREE.Mesh(ringGeo2, ringMat2);
      this.ring2.rotation.y = Math.PI / 4;
      this.ring2.position.set(0, -0.32, -0.04);
      this.quizGroup.add(this.ring2);

      // 4. PANEL 3D DE RESULTADOS FINALES (Oculto inicialmente)
      this.resultsCanvas = document.createElement('canvas');
      this.resultsCanvas.width = 1024;
      this.resultsCanvas.height = 600;
      this.resultsTexture = new THREE.CanvasTexture(this.resultsCanvas);
      this.resultsTexture.minFilter = THREE.LinearMipmapLinearFilter;
      this.resultsTexture.generateMipmaps = true;

      const resGeo = new THREE.PlaneGeometry(0.78, 0.46);
      const resMat = new THREE.MeshBasicMaterial({
        map: this.resultsTexture,
        transparent: true,
        side: THREE.DoubleSide
      });
      this.resultsMesh = new THREE.Mesh(resGeo, resMat);
      this.resultsMesh.position.set(0, 0.02, 0);
      this.resultsMesh.visible = false;
      this.resultsMesh.userData = { isResults: true };
      this.objectAnchor.add(this.resultsMesh);

      // Renderizar estado inicial de la pregunta 0
      this.renderCurrentQuestion();

      // Bucle de animación continuo WebXR
      const clock = new THREE.Clock();
      this.renderer.setAnimationLoop(() => {
        try {
          this.frameCount++;
          const elapsedTime = clock.getElapsedTime();

          if (this.isARActive) {
            if (this.frameCount === 3 || this.frameCount === 12 || this.frameCount === 30) {
              this.recenterInFrontOfCamera(0.80);
            }
          }

          // Rotación sutil de anillos decorativos
          if (this.ring1) this.ring1.rotation.z += 0.008;
          if (this.ring2) this.ring2.rotation.z -= 0.006;

          // Suave balanceo del cuestionario
          if (this.quizGroup && !this.isComplete) {
            this.quizGroup.position.y = Math.sin(elapsedTime * 1.5) * 0.012;
          }

          if (this.renderer && this.scene && this.camera) {
            this.renderer.render(this.scene, this.camera);
          }

          // Telemetría en el HUD en tiempo real
          if (this.isARActive && this.frameCount % 10 === 0 && this.statusText) {
            const p = this.objectAnchor?.position;
            const c = this.camera?.position;
            if (p && c) {
              this.statusText.textContent = `AR: Cam(${c.x.toFixed(1)}, ${c.y.toFixed(1)}, ${c.z.toFixed(1)}) | Q(${p.x.toFixed(1)}, ${p.y.toFixed(1)}, ${p.z.toFixed(1)})`;
            }
          }
        } catch (err: any) {
          if (this.statusText) {
            this.statusText.textContent = `Error 3D: ${err?.message || err}`;
            this.statusText.style.color = '#EF4444';
          }
          console.error('[WebXR Loop Error]', err);
        }
      });

      window.addEventListener('resize', () => {
        if (!this.isARActive && this.renderer && this.camera) {
          const w = window.innerWidth;
          const h = window.innerHeight;
          this.camera.aspect = w / h;
          this.camera.updateProjectionMatrix();
          this.renderer.setSize(w, h);
        }
      });
    }

    private getCurrentQuestion(): Question | null {
      if (!this.quizData || !this.quizData.preguntas || this.quizData.preguntas.length === 0) {
        return null;
      }
      return this.quizData.preguntas[this.currentIndex] || null;
    }

    private renderCurrentQuestion() {
      const q = this.getCurrentQuestion();
      const lang = getCurrentLang();
      const total = this.quizData?.preguntas?.length || 5;

      this.updateHUDProgress();

      if (!q) {
        this.renderPendingUnitState();
        return;
      }

      // 1. Dibujar Panel de Pregunta
      if (this.questionCanvas && this.questionTexture) {
        const ctx = this.questionCanvas.getContext('2d');
        if (ctx) {
          ctx.clearRect(0, 0, 1024, 540);

          // Fondo con gradiente verde oscuro institucional
          drawRoundedRect(ctx, 12, 12, 1000, 516, 28);
          ctx.fillStyle = 'rgba(2, 34, 20, 0.95)';
          ctx.fill();
          ctx.lineWidth = 6;
          ctx.strokeStyle = '#D4AF37';
          ctx.stroke();

          // Barra institucional
          ctx.fillStyle = '#D4AF37';
          ctx.font = 'bold 19px system-ui, sans-serif';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText('INSTITUTO POLITÉCNICO NACIONAL • UPIICSA', 512, 52);

          // Línea separadora dorada fina
          ctx.strokeStyle = 'rgba(212, 175, 55, 0.45)';
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(80, 78);
          ctx.lineTo(944, 78);
          ctx.stroke();

          // Sub-encabezado: Contador y tema
          const qLabel = lang === 'en' ? `QUESTION ${this.currentIndex + 1} OF ${total}` : `PREGUNTA ${this.currentIndex + 1} DE ${total}`;
          const topicLabel = lang === 'en' ? `Topic: ${q.tema}` : `Tema: ${q.tema}`;

          ctx.fillStyle = '#10B981';
          ctx.font = 'bold 18px system-ui, sans-serif';
          ctx.fillText(`${qLabel}  •  ${topicLabel}`, 512, 110);

          if (!this.feedbackState) {
            // Texto de la pregunta
            const statement = q.enunciado[lang] || q.enunciado.es;
            ctx.fillStyle = '#FFFFFF';
            ctx.font = 'bold 28px system-ui, sans-serif';
            ctx.textAlign = 'center';
            wrapTextLines(ctx, statement, 512, 210, 880, 44, 4);

            // Guía inferior
            ctx.fillStyle = '#FBBF24';
            ctx.font = 'bold 18px system-ui, sans-serif';
            const guide = lang === 'en'
              ? '👇 Tap the correct option card below on your screen'
              : '👇 Toca la tarjeta de la opción correcta abajo en tu pantalla';
            ctx.fillText(guide, 512, 455);
          } else {
            // MODO RETROALIMENTACIÓN TRAS RESPONDER
            if (this.feedbackState.isCorrect) {
              ctx.fillStyle = '#10B981';
              ctx.font = 'bold 36px system-ui, sans-serif';
              ctx.fillText(lang === 'en' ? '✅ CORRECT ANSWER!' : '✅ ¡RESPUESTA CORRECTA!', 512, 190);
            } else {
              ctx.fillStyle = '#EF4444';
              ctx.font = 'bold 36px system-ui, sans-serif';
              ctx.fillText(lang === 'en' ? '❌ INCORRECT ANSWER' : '❌ RESPUESTA INCORRECTA', 512, 190);
            }

            // Explicación didáctica
            const explanation = q.explicacion[lang] || q.explicacion.es;
            ctx.fillStyle = '#E5E7EB';
            ctx.font = '22px system-ui, sans-serif';
            wrapTextLines(ctx, explanation, 512, 270, 860, 36, 4);

            // Indicador de avance
            ctx.fillStyle = '#D4AF37';
            ctx.font = 'bold 18px system-ui, sans-serif';
            const moving = lang === 'en' ? '⏳ Advancing to next question...' : '⏳ Avanzando a la siguiente pregunta...';
            ctx.fillText(moving, 512, 460);
          }
        }
        this.questionTexture.needsUpdate = true;
      }

      // 2. Dibujar las 4 Tarjetas de Opciones
      const letters = ['A', 'B', 'C', 'D'];
      for (let i = 0; i < 4; i++) {
        const canvas = this.optionCanvases[i];
        const texture = this.optionTextures[i];
        const optText = q.opciones[i] ? (q.opciones[i][lang] || q.opciones[i].es) : '';

        let state: 'normal' | 'correct' | 'incorrect' | 'reveal' = 'normal';
        if (this.feedbackState) {
          if (i === q.respuestaCorrecta) {
            state = this.feedbackState.isCorrect ? 'correct' : 'reveal';
          } else if (!this.feedbackState.isCorrect) {
            // Marcar la seleccionada errónea
            const userChoice = (this as any).selectedOption;
            if (i === userChoice) state = 'incorrect';
          }
        }

        this.drawOptionCard(canvas, letters[i], optText, state);
        texture.needsUpdate = true;
      }
    }

    private drawOptionCard(
      canvas: HTMLCanvasElement,
      letter: string,
      text: string,
      state: 'normal' | 'correct' | 'incorrect' | 'reveal'
    ) {
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      ctx.clearRect(0, 0, 512, 186);

      let bgColor = 'rgba(2, 34, 20, 0.94)';
      let borderColor = '#D4AF37';
      let badgeColor = '#D4AF37';
      let badgeTextColor = '#00361F';

      if (state === 'correct') {
        bgColor = 'rgba(6, 95, 70, 0.96)';
        borderColor = '#10B981';
        badgeColor = '#10B981';
        badgeTextColor = '#FFFFFF';
      } else if (state === 'incorrect') {
        bgColor = 'rgba(127, 29, 29, 0.96)';
        borderColor = '#EF4444';
        badgeColor = '#EF4444';
        badgeTextColor = '#FFFFFF';
      } else if (state === 'reveal') {
        bgColor = 'rgba(6, 78, 59, 0.96)';
        borderColor = '#34D399';
        badgeColor = '#34D399';
        badgeTextColor = '#00361F';
      }

      // Fondo redondeado de la tarjeta
      drawRoundedRect(ctx, 8, 8, 496, 170, 18);
      ctx.fillStyle = bgColor;
      ctx.fill();
      ctx.lineWidth = 5;
      ctx.strokeStyle = borderColor;
      ctx.stroke();

      // Círculo con la letra de la opción (A, B, C, D)
      ctx.beginPath();
      ctx.arc(46, 93, 26, 0, Math.PI * 2);
      ctx.fillStyle = badgeColor;
      ctx.fill();

      ctx.fillStyle = badgeTextColor;
      ctx.font = 'bold 24px system-ui, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(letter, 46, 94);

      // Texto de la opción con ajuste automático multilínea
      ctx.fillStyle = '#FFFFFF';
      ctx.font = 'bold 20px system-ui, sans-serif';
      ctx.textAlign = 'left';
      ctx.textBaseline = 'middle';
      wrapTextLines(ctx, text, 88, 70, 395, 28, 3);
    }

    private renderPendingUnitState() {
      const lang = getCurrentLang();
      if (this.questionCanvas && this.questionTexture) {
        const ctx = this.questionCanvas.getContext('2d');
        if (ctx) {
          ctx.clearRect(0, 0, 1024, 540);
          drawRoundedRect(ctx, 12, 12, 1000, 516, 28);
          ctx.fillStyle = 'rgba(2, 34, 20, 0.95)';
          ctx.fill();
          ctx.lineWidth = 6;
          ctx.strokeStyle = '#D4AF37';
          ctx.stroke();

          ctx.fillStyle = '#D4AF37';
          ctx.font = 'bold 28px system-ui, sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText(
            lang === 'en' ? 'UNIT UNDER DEVELOPMENT' : 'UNIDAD EN DESARROLLO',
            512,
            240
          );
          ctx.fillStyle = '#E5E7EB';
          ctx.font = '20px system-ui, sans-serif';
          ctx.fillText(
            lang === 'en'
              ? 'The interactive quiz for this unit will be enabled in the next release.'
              : 'El cuestionario interactivo de esta unidad estará disponible próximamente.',
            512,
            300
          );
        }
        this.questionTexture.needsUpdate = true;
      }
    }

    private updateHUDProgress() {
      const total = this.quizData?.preguntas?.length || 5;
      const lang = getCurrentLang();
      if (this.hudProgressText) {
        this.hudProgressText.textContent = lang === 'en'
          ? `Q ${this.currentIndex + 1} / ${total}`
          : `P ${this.currentIndex + 1} / ${total}`;
      }
      if (this.hudScoreText) {
        this.hudScoreText.textContent = lang === 'en'
          ? `Score: ${this.score}`
          : `Aciertos: ${this.score}`;
      }
    }

    private pulseMesh(mesh: THREE.Mesh, duration = 320) {
      const start = performance.now();
      const origScale = mesh.scale.clone();
      const animatePulse = (now: number) => {
        const elapsed = now - start;
        if (elapsed < duration) {
          const factor = 1 + Math.sin((elapsed / duration) * Math.PI) * 0.16;
          mesh.scale.set(origScale.x * factor, origScale.y * factor, origScale.z);
          requestAnimationFrame(animatePulse);
        } else {
          mesh.scale.copy(origScale);
        }
      };
      requestAnimationFrame(animatePulse);
    }

    private shakeMesh(mesh: THREE.Mesh, duration = 400) {
      const start = performance.now();
      const origX = mesh.position.x;
      const animateShake = (now: number) => {
        const elapsed = now - start;
        if (elapsed < duration) {
          const offset = Math.sin((elapsed / duration) * Math.PI * 7) * 0.024;
          mesh.position.x = origX + offset;
          requestAnimationFrame(animateShake);
        } else {
          mesh.position.x = origX;
        }
      };
      requestAnimationFrame(animateShake);
    }

    public selectOption(index: number) {
      if (this.isLocked || this.isComplete) return;
      const q = this.getCurrentQuestion();
      if (!q) return;

      this.isLocked = true;
      (this as any).selectedOption = index;

      const isCorrect = (index === q.respuestaCorrecta);
      this.feedbackState = { isCorrect };

      if (isCorrect) {
        this.score++;
        this.soundFX.playCorrect();
        if ('vibrate' in navigator) {
          try { navigator.vibrate([40, 30, 80]); } catch {}
        }
        if (this.optionMeshes[index]) {
          this.pulseMesh(this.optionMeshes[index]);
        }
      } else {
        this.soundFX.playIncorrect();
        if ('vibrate' in navigator) {
          try { navigator.vibrate(220); } catch {}
        }
        if (this.optionMeshes[index]) {
          this.shakeMesh(this.optionMeshes[index]);
        }
      }

      this.renderCurrentQuestion();

      const delay = isCorrect ? 2400 : 3400;
      setTimeout(() => {
        const total = this.quizData?.preguntas?.length || 5;
        if (this.currentIndex + 1 < total) {
          this.currentIndex++;
          this.feedbackState = null;
          (this as any).selectedOption = undefined;
          this.renderCurrentQuestion();
          this.isLocked = false;
        } else {
          this.finishQuiz();
        }
      }, delay);
    }

    private finishQuiz() {
      this.isComplete = true;
      const total = this.quizData?.preguntas?.length || 5;
      const lang = getCurrentLang();
      const pct = Math.round((this.score / total) * 100);

      this.soundFX.playFanfare();
      if ('vibrate' in navigator) {
        try { navigator.vibrate([70, 50, 70, 50, 150]); } catch {}
      }

      // 1. Ocultar preguntas 3D y mostrar tarjeta de resultados 3D
      if (this.quizGroup) this.quizGroup.visible = false;
      if (this.resultsMesh) {
        this.resultsMesh.visible = true;
        this.drawResultsCard(pct, total, lang);
      }

      // 2. Mostrar modal de resultados en el DOM Overlay
      if (this.arResultsModal) {
        this.arResultsModal.style.display = 'flex';
      }
      if (this.hudResultsScore) {
        this.hudResultsScore.textContent = `${this.score} / ${total} (${pct}%)`;
      }
      if (this.hudResultsFeedback) {
        let msg = '';
        if (pct === 100) {
          msg = lang === 'en'
            ? '🏆 Outstanding! You mastered 100% of the unit concepts.'
            : '🏆 ¡Sobresaliente! Has dominado el 100% de los conceptos de la unidad.';
        } else if (pct >= 80) {
          msg = lang === 'en'
            ? '✨ Great job! Excellent academic comprehension.'
            : '✨ ¡Excelente trabajo! Demostraste un dominio sólido de los temas.';
        } else if (pct >= 60) {
          msg = lang === 'en'
            ? '👍 Good attempt! Review the lessons to reinforce details.'
            : '👍 ¡Buen intento! Te recomendamos repasar los temas para afianzar detalles.';
        } else {
          msg = lang === 'en'
            ? '💡 Keep practicing! Explore the unit topics again.'
            : '💡 ¡Sigue practicando! Repasa el contenido interactivo de la unidad.';
        }
        this.hudResultsFeedback.textContent = msg;
      }

      syncLanguageVisibility();
    }

    private drawResultsCard(pct: number, total: number, lang: 'es' | 'en') {
      if (!this.resultsCanvas || !this.resultsTexture) return;
      const ctx = this.resultsCanvas.getContext('2d');
      if (!ctx) return;

      ctx.clearRect(0, 0, 1024, 600);

      drawRoundedRect(ctx, 16, 16, 992, 568, 30);
      ctx.fillStyle = 'rgba(2, 34, 20, 0.96)';
      ctx.fill();
      ctx.lineWidth = 7;
      ctx.strokeStyle = '#D4AF37';
      ctx.stroke();

      // Trofeo
      ctx.font = '64px system-ui, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('🏆', 512, 90);

      // Título
      ctx.fillStyle = '#D4AF37';
      ctx.font = 'bold 34px system-ui, sans-serif';
      ctx.fillText(lang === 'en' ? 'QUIZ COMPLETED!' : '¡CUESTIONARIO COMPLETADO!', 512, 165);

      // Puntaje
      ctx.fillStyle = '#10B981';
      ctx.font = 'bold 46px system-ui, sans-serif';
      ctx.fillText(
        lang === 'en'
          ? `SCORE: ${this.score} / ${total} (${pct}%)`
          : `PUNTAJE: ${this.score} / ${total} (${pct}%)`,
        512,
        245
      );

      // Mensaje pedagógico
      ctx.fillStyle = '#E5E7EB';
      ctx.font = '22px system-ui, sans-serif';
      let msg = '';
      if (pct >= 80) {
        msg = lang === 'en'
          ? 'Outstanding performance on Herramientas Multimedia!'
          : '¡Excelente desempeño académico en Herramientas Multimedia!';
      } else {
        msg = lang === 'en'
          ? 'Good attempt! Review the unit materials to strengthen your knowledge.'
          : '¡Buen intento! Te sugerimos repasar los contenidos de la unidad.';
      }
      ctx.fillText(msg, 512, 315);

      // Botón 3D de reintento
      drawRoundedRect(ctx, 262, 410, 500, 78, 20);
      ctx.fillStyle = '#00643A';
      ctx.fill();
      ctx.lineWidth = 4;
      ctx.strokeStyle = '#D4AF37';
      ctx.stroke();

      ctx.fillStyle = '#FFFFFF';
      ctx.font = 'bold 24px system-ui, sans-serif';
      ctx.fillText(
        lang === 'en' ? '🔄 TAP HERE TO RETRY' : '🔄 TOCA AQUÍ PARA REINTENTAR',
        512,
        450
      );

      this.resultsTexture.needsUpdate = true;
    }

    public restartQuiz() {
      this.currentIndex = 0;
      this.score = 0;
      this.isLocked = false;
      this.isComplete = false;
      this.feedbackState = null;
      (this as any).selectedOption = undefined;

      if (this.arResultsModal) this.arResultsModal.style.display = 'none';
      if (this.resultsMesh) this.resultsMesh.visible = false;
      if (this.quizGroup) this.quizGroup.visible = true;

      this.renderCurrentQuestion();
      this.recenterInFrontOfCamera(0.80);
    }

    public recenterInFrontOfCamera(distance = 0.80) {
      if (!this.objectAnchor) return;
      try {
        let placed = false;
        if (this.camera) {
          const forward = new THREE.Vector3(0, 0, -distance);
          forward.applyQuaternion(this.camera.quaternion);
          forward.add(this.camera.position);
          if (!isNaN(forward.x) && !isNaN(forward.y) && !isNaN(forward.z)) {
            this.objectAnchor.position.copy(forward);
            this.objectAnchor.quaternion.copy(this.camera.quaternion);
            placed = true;
          }
        }
        if (!placed) {
          this.objectAnchor.position.set(0, 0, -distance);
          this.objectAnchor.quaternion.set(0, 0, 0, 1);
        }
      } catch (err) {
        console.warn('[WebXR] Error al recentrar:', err);
      }
    }

    private handleScreenInteraction(clientX: number, clientY: number) {
      const now = performance.now();
      if (now - this.lastInteractionTime < 280) return;
      this.lastInteractionTime = now;

      if (!this.camera) return;

      const ndc = new THREE.Vector2(
        (clientX / window.innerWidth) * 2 - 1,
        -(clientY / window.innerHeight) * 2 + 1
      );
      this.raycaster.setFromCamera(ndc, this.camera);

      // Si está en pantalla de resultados
      if (this.isComplete && this.resultsMesh && this.resultsMesh.visible) {
        const hits = this.raycaster.intersectObject(this.resultsMesh, true);
        if (hits.length > 0) {
          this.restartQuiz();
          return;
        }
      }

      // Si el cuestionario está en curso
      if (!this.isComplete && !this.isLocked && this.quizGroup && this.quizGroup.visible) {
        const hits = this.raycaster.intersectObjects(this.optionMeshes, true);
        if (hits.length > 0) {
          const optIdx = hits[0].object.userData.optionIndex;
          if (typeof optIdx === 'number') {
            this.selectOption(optIdx);
            return;
          }
        }
      }

      // Tocar espacio vacío recentra el cuestionario
      this.recenterInFrontOfCamera(0.80);
      if ('vibrate' in navigator) {
        try { navigator.vibrate(30); } catch {}
      }
    }

    private onControllerSelect() {
      const now = performance.now();
      if (now - this.lastInteractionTime < 280) return;
      this.lastInteractionTime = now;

      // Raycast central desde la vista de la cámara
      if (this.camera) {
        this.raycaster.setFromCamera(new THREE.Vector2(0, 0), this.camera);

        if (this.isComplete && this.resultsMesh && this.resultsMesh.visible) {
          const hits = this.raycaster.intersectObject(this.resultsMesh, true);
          if (hits.length > 0) {
            this.restartQuiz();
            return;
          }
        }

        if (!this.isComplete && !this.isLocked) {
          const hits = this.raycaster.intersectObjects(this.optionMeshes, true);
          if (hits.length > 0) {
            const optIdx = hits[0].object.userData.optionIndex;
            if (typeof optIdx === 'number') {
              this.selectOption(optIdx);
              return;
            }
          }
        }
      }

      this.recenterInFrontOfCamera(0.80);
    }

    private bindEvents() {
      this.btnStartAR?.addEventListener('click', () => {
        this.soundFX.init();
        this.startARSession();
      });

      this.btnExitAR?.addEventListener('click', (e) => {
        e.stopPropagation();
        this.endARSession();
      });

      this.btnRecenterAR?.addEventListener('click', (e) => {
        e.stopPropagation();
        this.recenterInFrontOfCamera(0.80);
      });

      // Tocar en el plano táctil de pantalla completa en RA
      const touchPlane = document.getElementById('ar-touch-plane');
      touchPlane?.addEventListener('click', (e: MouseEvent) => {
        e.stopPropagation();
        this.handleScreenInteraction(e.clientX, e.clientY);
      });

      touchPlane?.addEventListener('touchend', (e: TouchEvent) => {
        if (e.changedTouches && e.changedTouches.length > 0) {
          e.stopPropagation();
          const t = e.changedTouches[0];
          this.handleScreenInteraction(t.clientX, t.clientY);
        }
      }, { passive: true });

      // Botones del modal de resultados
      this.btnResultsRetry?.addEventListener('click', (e) => {
        e.stopPropagation();
        this.restartQuiz();
      });

      this.btnResultsExit?.addEventListener('click', (e) => {
        e.stopPropagation();
        this.endARSession();
      });

      this.btnRecheckAR?.addEventListener('click', () => this.checkWebXRSupport());
      this.btnRetryAR?.addEventListener('click', () => this.checkWebXRSupport());

      window.addEventListener('storage', (e) => {
        if (e.key === 'upiicsa_gt_lang') {
          syncLanguageVisibility();
          this.renderCurrentQuestion();
        }
      });
      document.addEventListener('astro:page-load', () => {
        syncLanguageVisibility();
        this.renderCurrentQuestion();
      });
    }

    private showState(state: 'checking' | 'supported' | 'unsupported' | 'error', errorMsg?: string) {
      if (this.stateChecking) this.stateChecking.style.display = state === 'checking' ? 'flex' : 'none';
      if (this.stateSupported) this.stateSupported.style.display = state === 'supported' ? 'block' : 'none';
      if (this.stateUnsupported) this.stateUnsupported.style.display = state === 'unsupported' ? 'block' : 'none';
      if (this.stateError) {
        this.stateError.style.display = state === 'error' ? 'block' : 'none';
        if (errorMsg && this.errorText) this.errorText.textContent = errorMsg;
      }
      syncLanguageVisibility();
    }

    public async checkWebXRSupport() {
      this.showState('checking');

      if (!('xr' in navigator) || !navigator.xr) {
        this.showState('unsupported');
        return;
      }

      try {
        const isSupported = await navigator.xr.isSessionSupported('immersive-ar');
        if (isSupported) {
          this.showState('supported');
        } else {
          this.showState('unsupported');
        }
      } catch (err) {
        console.warn('[WebXR] Error comprobando soporte:', err);
        this.showState('unsupported');
      }
    }

    private async startARSession() {
      if (!navigator.xr || !this.renderer) return;

      try {
        const sessionInit: XRSessionInit = {
          requiredFeatures: ['local'],
          optionalFeatures: ['dom-overlay', 'hit-test', 'local-floor'],
        };

        if (this.arDomOverlay) {
          this.arDomOverlay.style.display = 'flex';
          sessionInit.domOverlay = { root: this.arDomOverlay };
        }

        const session = await navigator.xr.requestSession('immersive-ar', sessionInit);
        this.onSessionStarted(session);
      } catch (err: any) {
        console.error('[WebXR] Fallo al iniciar sesión AR:', err);
        if (this.arDomOverlay) {
          this.arDomOverlay.style.display = 'none';
        }
        const msg = err?.message || 'Permiso de cámara denegado o error de inicialización en el dispositivo.';
        this.showState('error', msg);
      }
    }

    private async onSessionStarted(session: XRSession) {
      this.xrSession = session;
      this.isARActive = true;
      this.frameCount = 0;

      session.addEventListener('end', () => this.onSessionEnded());

      if (this.arDomOverlay) {
        this.arDomOverlay.style.display = 'flex';
      }

      if (!this.renderer) return;

      this.renderer.xr.enabled = true;
      this.renderer.xr.setReferenceSpaceType('local');
      await this.renderer.xr.setSession(session);

      // Posicionamiento inicial frente a la cámara a 80 cm
      this.recenterInFrontOfCamera(0.80);
      this.renderCurrentQuestion();
    }

    private endARSession() {
      if (this.xrSession) {
        this.xrSession.end().catch(() => {});
      }
    }

    private onSessionEnded() {
      this.isARActive = false;
      this.frameCount = 0;
      this.xrSession = null;

      if (this.arDomOverlay) {
        this.arDomOverlay.style.display = 'none';
      }

      if (this.renderer) {
        this.renderer.domElement.style.display = 'none';
      }

      if (this.objectAnchor) {
        this.objectAnchor.position.set(0, 0, -0.80);
        this.objectAnchor.rotation.set(0, 0, 0);
      }

      this.showState('supported');
    }
  }

  function initWebXR() {
    syncLanguageVisibility();
    new WebXRQuizController();
  }

  initWebXR();
  document.addEventListener('astro:page-load', initWebXR);
</script>

