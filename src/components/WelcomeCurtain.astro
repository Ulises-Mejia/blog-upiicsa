---
import { siteBrand } from '../config/site';

interface Props {
  isEn?: boolean;
}

const { isEn = false } = Astro.props;
const currentYear = new Date().getFullYear();

const institutionLabel = `${siteBrand.institution} • ${siteBrand.campus}`;
const description = isEn ? siteBrand.welcomeDescription.en : siteBrand.welcomeDescription.es;
const buttonLabel = isEn ? siteBrand.welcomeButton.en : siteBrand.welcomeButton.es;
const dismissHint = isEn ? 'Press Escape or click to enter' : 'Presiona Esc o haz clic para ingresar';
const copyrightText = isEn
  ? `© ${currentYear} Instituto Politécnico Nacional — ${siteBrand.campus}. All rights reserved.`
  : `© ${currentYear} Instituto Politécnico Nacional — ${siteBrand.campus}. Todos los derechos reservados.`;
---

<dialog
  id="welcomeCurtain"
  class="welcome-curtain"
  aria-labelledby="curtainTitle"
  {...({ closedby: 'any' } as Record<string, string>)}
>
  <div class="curtain-overlay" id="curtainOverlay" aria-hidden="true"></div>

  <div class="curtain-container">
    <div class="curtain-card">
      <!-- Anillos y Logos Centrales (IPN y UPIICSA) -->
      <div class="curtain-logos-group">
        <div class="curtain-logo-wrapper" title="Instituto Politécnico Nacional">
          <div class="curtain-logo-glow" aria-hidden="true"></div>
          <img
            src={siteBrand.ipnLogoUrl}
            alt={siteBrand.ipnLogoAlt}
            width="88"
            height="88"
            class="curtain-logo"
          />
        </div>

        <div class="curtain-logos-divider" aria-hidden="true"></div>

        <div class="curtain-logo-wrapper" title="UPIICSA">
          <div class="curtain-logo-glow" aria-hidden="true"></div>
          <img
            src={siteBrand.upiicsaLogoUrl}
            alt={siteBrand.upiicsaLogoAlt}
            width="88"
            height="88"
            class="curtain-logo"
          />
        </div>
      </div>

      <!-- Insignia Institucional -->
      <div class="curtain-badge-tag">
        <span class="badge-dot" aria-hidden="true"></span>
        <span>{institutionLabel}</span>
      </div>

      <!-- Título Principal -->
      <h1 id="curtainTitle" class="curtain-title">
        {siteBrand.title}
        <span class="title-highlight">{siteBrand.badge}</span>
      </h1>

      <!-- Subtítulo / Descripción Breve -->
      <p class="curtain-description">
        {description}
      </p>

      <!-- Botón de Acción Principal -->
      <div class="curtain-actions">
        <button
          id="enterRepoBtn"
          class="enter-btn"
          type="button"
          autofocus
        >
          <span class="enter-btn-icon" aria-hidden="true">🚀</span>
          <span>{buttonLabel}</span>
        </button>
      </div>

      <span class="curtain-hint">{dismissHint}</span>
    </div>

    <!-- Pie sutil con Derechos de Autor (evita duplicar landmark contentinfo) -->
    <p class="curtain-footer">{copyrightText}</p>
  </div>
</dialog>

<!-- SCRIPT ANTI-FOUC INLINE: abre el <dialog> modal en primer render si aún no se vio en esta sesión -->
<script is:inline>
  (function () {
    try {
      var curtain = document.getElementById('welcomeCurtain');
      if (!curtain || typeof curtain.showModal !== 'function') return;
      var params = new URLSearchParams(window.location.search);
      if (params.has('welcome')) {
        sessionStorage.removeItem('upiicsa_welcome_seen');
        curtain.showModal();
      } else if (sessionStorage.getItem('upiicsa_welcome_seen') !== 'true') {
        curtain.showModal();
      }
    } catch (e) {}
  })();
</script>

<script>
  let cleanupWelcomeCurtain: (() => void) | null = null;
  let supportsDisplayTransition: boolean | undefined;

  function canTransitionDisplay(): boolean {
    if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
    if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
      return false;
    }
    const probe = document.createElement('div');
    probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
    document.body.appendChild(probe);
    getComputedStyle(probe).display;
    probe.style.display = 'none';
    supportsDisplayTransition = getComputedStyle(probe).display === 'block';
    probe.remove();
    return supportsDisplayTransition;
  }

  function supportsTopLayerExit(): boolean {
    return Boolean(window.CSS?.supports?.('overlay', 'auto')) && canTransitionDisplay();
  }

  function setupWelcomeCurtain() {
    if (cleanupWelcomeCurtain) {
      cleanupWelcomeCurtain();
      cleanupWelcomeCurtain = null;
    }

    const curtain = document.getElementById('welcomeCurtain') as HTMLDialogElement | null;
    const enterBtn = document.getElementById('enterRepoBtn');
    const card = curtain?.querySelector<HTMLElement>('.curtain-card') ?? null;

    if (!curtain) return;

    // Si ya se vio y no está abierto, quitar del DOM para mantener el árbol ligero
    if (!curtain.open) {
      try {
        const params = new URLSearchParams(window.location.search);
        if (params.has('welcome')) {
          sessionStorage.removeItem('upiicsa_welcome_seen');
          curtain.showModal();
        } else if (sessionStorage.getItem('upiicsa_welcome_seen') === 'true') {
          curtain.remove();
          return;
        } else {
          curtain.showModal();
        }
      } catch {
        curtain.showModal();
      }
    }

    let isClosing = false;
    let pressedOutsideCard = false;

    const markSeen = () => {
      try {
        sessionStorage.setItem('upiicsa_welcome_seen', 'true');
      } catch {}
    };

    const cleanup = () => {
      enterBtn?.removeEventListener('click', onButtonClose);
      curtain.removeEventListener('cancel', onCancel);
      curtain.removeEventListener('close', onNativeClose);
      curtain.removeEventListener('pointerdown', onPointerDown);
      curtain.removeEventListener('pointerup', onPointerUp);
      cleanupWelcomeCurtain = null;
    };

    const closeCurtain = async () => {
      if (isClosing || !curtain.open) return;
      isClosing = true;
      markSeen();

      if (!supportsTopLayerExit()) {
        curtain.setAttribute('data-closing', '');
        const animations = curtain.getAnimations({ subtree: true });
        if (animations.length > 0) {
          await Promise.race([
            Promise.allSettled(animations.map((a) => a.finished)),
            new Promise((resolve) => window.setTimeout(resolve, 700)),
          ]);
        }
        curtain.removeAttribute('data-closing');
      }

      if (curtain.open) {
        curtain.close('entered');
      }
    };

    const onButtonClose = () => {
      void closeCurtain();
    };

    // Interceptar cierre nativo (Esc / closedby) para reproducir la transición de cortina
    const onCancel = (e: Event) => {
      e.preventDefault();
      void closeCurtain();
    };

    const onNativeClose = () => {
      markSeen();
      curtain.returnValue = '';
      cleanup();
      const animations = curtain.getAnimations();
      if (animations.length > 0) {
        Promise.allSettled(animations.map((a) => a.finished)).finally(() => curtain.remove());
      } else {
        curtain.remove();
      }
    };

    // Light-dismiss al hacer clic fuera de la tarjeta (respaldo también en Safari sin closedby)
    const isOutsideCard = (e: PointerEvent): boolean => {
      if (!card) return true;
      const r = card.getBoundingClientRect();
      return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
    };

    const onPointerDown = (e: PointerEvent) => {
      pressedOutsideCard = isOutsideCard(e);
    };

    const onPointerUp = (e: PointerEvent) => {
      if (pressedOutsideCard && isOutsideCard(e)) {
        void closeCurtain();
      }
      pressedOutsideCard = false;
    };

    enterBtn?.addEventListener('click', onButtonClose);
    curtain.addEventListener('cancel', onCancel);
    curtain.addEventListener('close', onNativeClose);
    curtain.addEventListener('pointerdown', onPointerDown);
    curtain.addEventListener('pointerup', onPointerUp);
    cleanupWelcomeCurtain = cleanup;
  }

  setupWelcomeCurtain();
  document.addEventListener('astro:page-load', setupWelcomeCurtain);
</script>

<style>
  dialog.welcome-curtain {
    position: fixed;
    inset: 0;
    width: 100vw;
    max-width: none;
    height: 100vh;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: none;
    overflow: auto;
    background-color: #06170E;
    color: #FFFFFF;
    opacity: 0;
    transition-property: opacity, transform, display, overlay;
    transition-duration: 0.5s;
    transition-timing-function: cubic-bezier(0.76, 0, 0.24, 1);
    transition-behavior: allow-discrete;
  }

  @media (prefers-reduced-motion: no-preference) {
    dialog.welcome-curtain {
      transform: translateY(-100%);
    }
  }

  dialog.welcome-curtain[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  dialog.welcome-curtain[open]:where(:not([data-closing])) {
    opacity: 1;
    transform: translateY(0);
  }

  dialog.welcome-curtain:modal {
    overscroll-behavior: contain;
  }

  dialog.welcome-curtain::backdrop {
    background-color: #06170E;
    overflow: hidden;
    overscroll-behavior: contain;
    transition-property: opacity, display, overlay;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
    transition-behavior: allow-discrete;
  }

  @media (prefers-reduced-motion: reduce) {
    dialog.welcome-curtain,
    dialog.welcome-curtain::backdrop {
      transition-duration: 0.12s;
    }
  }

  /* Fondo completamente opaco con atmósfera institucional */
  .curtain-overlay {
    position: fixed;
    inset: 0;
    background: radial-gradient(
      circle at 50% 35%,
      #00361F 0%,
      #06170E 80%
    );
  }

  :global(:root[data-theme='light']) dialog.welcome-curtain {
    background-color: #071C12;
  }

  :global(:root[data-theme='light']) .curtain-overlay {
    background: radial-gradient(
      circle at 50% 35%,
      #004D2C 0%,
      #06170E 80%
    );
  }

  /* Contenedor central y tarjeta */
  .curtain-container {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    min-height: 100vh;
    min-height: 100dvh;
    padding: 2.5rem 1.5rem 1.5rem;
    box-sizing: border-box;
    width: 100%;
    max-width: 650px;
    margin: 0 auto;
  }

  .curtain-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin: auto 0;
    padding: 2.2rem 2rem;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(212, 175, 55, 0.25);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    width: 100%;
    box-sizing: border-box;
  }

  @media (prefers-reduced-motion: no-preference) {
    .curtain-card {
      animation: curtainCardIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }

  @keyframes curtainCardIn {
    0% {
      opacity: 0;
      transform: translateY(24px) scale(0.96);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Contenedor de Logos Institucionales */
  .curtain-logos-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .curtain-logos-divider {
    width: 2px;
    height: 48px;
    background: linear-gradient(to bottom, transparent, rgba(212, 175, 55, 0.7), transparent);
  }

  /* Anillo y Logo */
  .curtain-logo-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 108px;
    height: 108px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    border: 2px solid rgba(212, 175, 55, 0.45);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .curtain-logo-wrapper:hover {
    transform: scale(1.06);
  }

  .curtain-logo-glow {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(212, 175, 55, 0.25) 0%, transparent 70%);
    filter: blur(8px);
    z-index: 0;
  }

  .curtain-logo {
    position: relative;
    z-index: 1;
    width: 86px;
    height: 86px;
    object-fit: contain;
    border-radius: 50%;
  }

  /* Insignia */
  .curtain-badge-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(212, 175, 55, 0.12);
    border: 1px solid rgba(212, 175, 55, 0.35);
    color: #D4AF37;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    padding: 4px 14px;
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #D4AF37;
    box-shadow: 0 0 8px #D4AF37;
  }

  /* Título */
  .curtain-title {
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: 1px;
    color: #FFFFFF;
    margin: 0 0 0.75rem 0;
    line-height: 1.15;
    text-wrap: balance;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .title-highlight {
    background: #D4AF37;
    color: #00361F;
    font-size: 1.1rem;
    font-weight: 900;
    padding: 3px 10px;
    border-radius: 6px;
    letter-spacing: 0.5px;
  }

  /* Descripción */
  .curtain-description {
    font-size: 0.96rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 1.75rem 0;
    max-width: 480px;
    text-wrap: pretty;
  }

  /* Botón de Entrada */
  .curtain-actions {
    margin-bottom: 0.75rem;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .enter-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: #D4AF37;
    color: #00361F;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.3px;
    padding: 13px 32px;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(212, 175, 55, 0.35);
    transition: transform 0.25s cubic-bezier(0.2, 0, 0, 1), background-color 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
  }

  .enter-btn:hover {
    background: #FFFFFF;
    color: #00643A;
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 10px 25px rgba(255, 255, 255, 0.3);
  }

  .enter-btn:active {
    transform: translateY(0) scale(0.98);
  }

  .enter-btn:focus-visible {
    outline: 3px solid #FFFFFF;
    outline-offset: 3px;
  }

  .enter-btn-icon {
    font-size: 1.15rem;
    transition: transform 0.2s ease;
  }

  .enter-btn:hover .enter-btn-icon {
    transform: translateX(3px) translateY(-1px);
  }

  /* Pista accesible */
  .curtain-hint {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.65);
    margin-top: 0.25rem;
  }

  /* Pie discreto con derechos de autor */
  .curtain-footer {
    margin: 0;
    padding-top: 1rem;
    font-size: 0.76rem;
    color: rgba(212, 175, 55, 0.8);
    text-align: center;
    letter-spacing: 0.3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .curtain-logo-wrapper,
    .enter-btn,
    .enter-btn-icon {
      transition: background-color 0.2s ease, color 0.2s ease !important;
      transform: none !important;
    }
  }

  @media (max-width: 600px) {
    .curtain-logos-group {
      gap: 0.85rem;
      margin-bottom: 1rem;
    }
    .curtain-logo-wrapper {
      width: 88px;
      height: 88px;
    }
    .curtain-logo {
      width: 70px;
      height: 70px;
    }
    .curtain-logos-divider {
      height: 38px;
    }
    .curtain-card {
      padding: 1.75rem 1.25rem;
    }
    .curtain-title {
      font-size: 1.7rem;
    }
    .title-highlight {
      font-size: 0.95rem;
    }
    .curtain-description {
      font-size: 0.88rem;
    }
    .enter-btn {
      width: 100%;
      padding: 12px 20px;
    }
    .curtain-footer {
      font-size: 0.7rem;
    }
  }
</style>
