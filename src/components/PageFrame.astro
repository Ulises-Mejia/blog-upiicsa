---
import MobileMenuToggle from '@astrojs/starlight/components/MobileMenuToggle.astro';
import WelcomeCurtain from './WelcomeCurtain.astro';

const { hasSidebar, id } = Astro.locals.starlightRoute;
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Detectar si la página actual es la portada institucional
const isHome = id === 'es' || id === '' || id === 'es/index' ||
  currentPath === `${base}/` || currentPath === `${base}/es/` || currentPath === `${base}/es` ||
  currentPath === '/' || currentPath === '/es/' || currentPath === '/es';

const year = new Date().getFullYear();
const identityHref = `${base}/es/identidad-ipn/`;
const identityText = '🏛️ Identidad IPN';
const identityShort = '🏛️ Identidad';

const authorsHref = `${base}/es/autores/`;
const authorsText = '👥 Autores y Créditos';
const authorsShort = '👥 Autores';

const copyrightDesktop = `© ${year} Instituto Politécnico Nacional — UPIICSA. Todos los derechos reservados.`;
const copyrightMobile = `© ${year} IPN — UPIICSA`;
const courseLabel = 'UPII';
const mottoText = 'La Técnica al Servicio de la Patria';
---

<div class="page sl-flex">
	{isHome && <WelcomeCurtain />}
	<header class="header"><slot name="header" /></header>
	{
		hasSidebar && (
			<nav class="sidebar print:hidden" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
				<MobileMenuToggle />
				<script>
					class StarlightSidebarPane extends HTMLElement {
						constructor() {
							super();
							matchMedia('(min-width: 50em)').addEventListener('change', () => this.hidePopover());
							this.addEventListener('toggle', ({ newState }) => {
								if (newState === 'open') {
									this.querySelectorAll<HTMLDetailsElement>('.top-level > li > details[open]').forEach((d) => {
										d.open = false;
									});
								}
								this.trapFocus(newState === 'open');
							});
						}
						trapFocus(shouldTrap: boolean) {
							document.querySelectorAll<HTMLElement>('.main-frame, .sl-skip-link').forEach((el) => {
								el.toggleAttribute('inert', shouldTrap);
							});
						}
					}
					customElements.define('sl-sidebar-pane', StarlightSidebarPane);
				</script>
				<sl-sidebar-pane popover="" id="starlight__sidebar" class="sidebar-pane">
					<div class="sidebar-content sl-flex">
						<slot name="sidebar" />
					</div>
				</sl-sidebar-pane>
			</nav>
		)
	}
	<div class="main-frame"><slot /></div>

	<!-- ELEMENTO INVISIBLE DE GOOGLE TRANSLATE (CARGA BAJO DEMANDA) -->
	<div id="google_translate_element" hidden aria-hidden="true"></div>

	<!-- CARGADOR BAJO DEMANDA DE GOOGLE TRANSLATE (SOLO SI EL USUARIO TRADUCE O TIENE COOKIE /en) -->
	<script is:inline>
		window.googleTranslateElementInit = function() {
			try {
				new window.google.translate.TranslateElement({
					pageLanguage: 'es',
					includedLanguages: 'es,en',
					autoDisplay: false
				}, 'google_translate_element');
			} catch (e) {}
		};
		window.__loadGoogleTranslate = function() {
			if (window.__gtScriptRequested || document.querySelector('.goog-te-combo')) return;
			window.__gtScriptRequested = true;
			var s = document.createElement('script');
			s.src = 'https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
			s.async = true;
			s.referrerPolicy = 'no-referrer';
			document.body.appendChild(s);
		};
		(function() {
			try {
				var cookie = document.cookie || '';
				var hasEnCookie = /(?:^|;\s*)googtrans=[^;]*\/en\b/i.test(decodeURIComponent(cookie));
				var hasEnPref = localStorage.getItem('upiicsa_gt_lang') === 'en';
				if (hasEnCookie || hasEnPref) {
					window.__loadGoogleTranslate();
				}
			} catch (e) {}
		})();
	</script>

	<!-- BARRA INFERIOR INSTITUCIONAL EXCLUSIVA (CRISTAL TRANSLÚCIDO, DEGRADADO E IDENTIDAD VISUAL) -->
	<footer class="shell-footer" aria-label="Derechos de autor, identidad y créditos">
		<div class="shell-footer-inner">
			<div class="shell-footer-legal">
				<span class="footer-brand-pill">
					<span class="footer-brand-dots" aria-hidden="true"></span>
					<span>{courseLabel}</span>
				</span>
				<span class="copyright-desktop">{copyrightDesktop}</span>
				<span class="copyright-mobile">{copyrightMobile}</span>
				<span class="footer-motto-sep" aria-hidden="true">•</span>
				<span class="footer-motto">{mottoText}</span>
			</div>
			<div class="shell-footer-actions">
				<a href={identityHref} class="footer-btn" title={identityText}>
					<span class="btn-text-full">{identityText}</span>
					<span class="btn-text-short">{identityShort}</span>
				</a>
				<a href={authorsHref} class="footer-btn" title={authorsText}>
					<span class="btn-text-full">{authorsText}</span>
					<span class="btn-text-short">{authorsShort}</span>
				</a>
			</div>
		</div>
	</footer>
</div>

<style>
	@layer starlight.core {
		.page {
			flex-direction: column;
			min-height: 100vh;
			min-height: 100dvh;
		}

		.header {
			z-index: var(--sl-z-index-navbar);
			position: fixed;
			inset-inline-start: 0;
			inset-block-start: 0;
			width: 100%;
			height: var(--sl-nav-height);
			border-bottom: 1px solid var(--sl-color-hairline-shade);
			padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
			padding-inline-end: var(--sl-nav-pad-x);
			background-color: var(--sl-color-bg-nav);
		}

		:global([data-has-sidebar]) .header {
			padding-inline-end: calc(
				var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
			);
		}

		.sidebar-pane {
			border: unset;
			padding: unset;
			height: unset;
			color: unset;

			position: fixed;
			z-index: var(--sl-z-index-menu);
			inset-block: var(--sl-nav-height) 40px;
			inset-inline-start: 0;
			width: 100%;
			background-color: var(--sl-color-black);
			overflow-y: auto;
			scrollbar-gutter: stable;
		}

		.sidebar-content {
			height: 100%;
			min-height: max-content;
			padding: 1rem var(--sl-sidebar-pad-x) 0;
			flex-direction: column;
			gap: 1rem;
		}

		@media (min-width: 50rem) {
			.sidebar-content::after {
				content: '';
				padding-bottom: 1px;
			}
		}

		.main-frame {
			padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
			padding-inline-start: var(--sl-content-inline-start);
			padding-bottom: 50px;
		}

		@media (min-width: 50rem) {
			:global([data-has-sidebar]) .header {
				padding-inline-end: var(--sl-nav-pad-x);
			}
			.sidebar-pane {
				display: block;
				width: var(--sl-sidebar-width);
				background-color: var(--sl-color-bg-sidebar);
				border-inline-end: 1px solid var(--sl-color-hairline-shade);
				inset-block: var(--sl-nav-height) 42px;
			}
		}

		/* BARRA INFERIOR INSTITUCIONAL (CRISTAL TRANSLÚCIDO, DEGRADADO OKLAB E IDENTIDAD IPN/UPIICSA) */
		.shell-footer {
			position: fixed;
			bottom: 0;
			left: 0;
			width: 100%;
			height: 42px;
			background:
				repeating-linear-gradient(
					135deg,
					rgba(244, 232, 193, 0.04) 0 1px,
					transparent 1px 14px
				),
				radial-gradient(
					ellipse 30% 130% at 8% 50%,
					rgba(212, 175, 55, 0.12) 0%,
					transparent 72%
				),
				radial-gradient(
					ellipse 30% 130% at 92% 50%,
					rgba(108, 29, 69, 0.34) 0%,
					transparent 74%
				),
				linear-gradient(
					100deg var(--in-oklab),
					rgba(0, 76, 44, 0.88) 0%,
					rgba(0, 60, 35, 0.9) 54%,
					rgba(20, 41, 36, 0.91) 100%
				) !important;
			backdrop-filter: blur(18px) saturate(165%) !important;
			-webkit-backdrop-filter: blur(18px) saturate(165%) !important;
			border-top: 1px solid rgba(212, 175, 55, 0.36) !important;
			box-shadow:
				0 -2px 6px rgba(0, 24, 14, 0.14),
				0 -8px 24px rgba(0, 20, 12, 0.2),
				inset 0 1px 0 rgba(255, 255, 255, 0.14);
			z-index: 90;
			display: flex;
			align-items: center;
			box-sizing: border-box;
			isolation: isolate;
		}

		/* Ribete superior tricolor institucional (Guinda IPN · Oro · Verde UPIICSA) */
		.shell-footer::before {
			content: "";
			position: absolute;
			inset-block-start: -1px;
			inset-inline: 0;
			height: 2px;
			pointer-events: none;
			background: linear-gradient(
				90deg var(--in-oklab),
				#6C1D45 0%,
				#D4AF37 22%,
				#008F53 50%,
				#D4AF37 78%,
				#6C1D45 100%
			);
			opacity: 0.9;
		}

		:global(:root[data-theme='dark']) .shell-footer {
			background:
				repeating-linear-gradient(
					135deg,
					rgba(212, 175, 55, 0.045) 0 1px,
					transparent 1px 14px
				),
				radial-gradient(
					ellipse 30% 130% at 8% 50%,
					rgba(0, 100, 58, 0.3) 0%,
					transparent 72%
				),
				radial-gradient(
					ellipse 30% 130% at 92% 50%,
					rgba(108, 29, 69, 0.28) 0%,
					transparent 74%
				),
				linear-gradient(
					100deg var(--in-oklab),
					rgba(9, 30, 19, 0.8) 0%,
					rgba(6, 20, 13, 0.84) 55%,
					rgba(15, 19, 20, 0.86) 100%
				) !important;
			border-top: 1px solid rgba(212, 175, 55, 0.28) !important;
			box-shadow:
				0 -2px 8px rgba(0, 0, 0, 0.32),
				0 -10px 28px rgba(0, 0, 0, 0.42),
				inset 0 1px 0 rgba(244, 232, 193, 0.12);
		}

		@supports not (backdrop-filter: blur(1px)) {
			.shell-footer {
				background: linear-gradient(100deg, #004C2C 0%, #003C23 55%, #142924 100%) !important;
			}
			:global(:root[data-theme='dark']) .shell-footer {
				background: linear-gradient(100deg, #091E13 0%, #06140D 60%, #101416 100%) !important;
			}
		}

		.shell-footer-inner {
			display: flex;
			justify-content: space-between;
			align-items: center;
			width: 100%;
			height: 100%;
			padding: 0 1.25rem;
			box-sizing: border-box;
			gap: 1rem;
		}

		.shell-footer-legal {
			display: flex;
			align-items: center;
			gap: 9px;
			font-size: 0.8rem;
			font-weight: 500;
			color: rgba(255, 255, 255, 0.94);
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
			min-width: 0;
		}

		.footer-brand-pill {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			padding: 2px 8px;
			border-radius: 999px;
			font-size: 0.72rem;
			font-weight: 800;
			letter-spacing: 0.08em;
			color: #F4E8C1;
			background: rgba(0, 32, 18, 0.36);
			border: 1px solid rgba(212, 175, 55, 0.48);
			flex-shrink: 0;
		}

		.footer-brand-dots {
			width: 14px;
			height: 6px;
			border-radius: 999px;
			background: linear-gradient(90deg, #8E2B5C 0 33%, #D4AF37 33% 66%, #10B981 66% 100%);
			flex-shrink: 0;
		}

		.footer-motto-sep {
			color: rgba(212, 175, 55, 0.75);
			font-size: 0.85rem;
		}

		.footer-motto {
			color: #F4E8C1;
			font-style: italic;
			font-weight: 500;
			font-size: 0.77rem;
		}

		.copyright-mobile {
			display: none;
		}

		.shell-footer-actions {
			display: flex;
			align-items: center;
			gap: 8px;
			flex-shrink: 0;
		}

		.footer-btn {
			display: inline-flex;
			align-items: center;
			gap: 5px;
			font-size: 0.76rem;
			font-weight: 700;
			color: #F4E8C1 !important;
			background: linear-gradient(180deg var(--in-oklab), rgba(255, 255, 255, 0.13) 0%, rgba(255, 255, 255, 0.05) 100%);
			border: 1px solid rgba(212, 175, 55, 0.45);
			box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14);
			padding: 4px 11px;
			border-radius: 7px;
			text-decoration: none !important;
			transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
			white-space: nowrap;
		}

		.footer-btn:hover {
			background: linear-gradient(135deg var(--in-oklab), #E4C45A 0%, #D4AF37 100%);
			color: #00361F !important;
			border-color: #E4C45A;
			transform: translateY(-1px);
			box-shadow: 0 3px 12px rgba(212, 175, 55, 0.34);
		}

		.footer-btn:focus-visible {
			outline: 2.5px solid #F4E8C1;
			outline-offset: 2px;
		}

		.btn-text-short {
			display: none;
		}

		@media (max-width: 1120px) {
			.footer-motto,
			.footer-motto-sep {
				display: none;
			}
		}

		@media (max-width: 768px) {
			.shell-footer {
				height: 40px;
			}
			.sidebar-pane {
				inset-block: var(--sl-nav-height) 40px;
			}
			.main-frame {
				padding-bottom: 48px;
			}
			.shell-footer-inner {
				padding: 0 0.75rem;
				gap: 0.5rem;
			}
			.copyright-desktop {
				display: none;
			}
			.copyright-mobile {
				display: inline;
				font-weight: 600;
			}
			.btn-text-full {
				display: none;
			}
			.btn-text-short {
				display: inline;
			}
		}

		@media (max-width: 480px) {
			.footer-brand-pill {
				display: none;
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.footer-btn {
				transition: none;
				transform: none;
			}
		}

		@media (forced-colors: active) {
			.shell-footer {
				background: Canvas !important;
				border-top: 2px solid CanvasText !important;
				backdrop-filter: none !important;
			}
			.shell-footer::before {
				display: none;
			}
			.footer-brand-pill,
			.footer-btn {
				border: 1px solid CanvasText !important;
				color: CanvasText !important;
				background: Canvas !important;
			}
		}
	}
</style>
